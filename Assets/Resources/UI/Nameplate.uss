.nameplate-root {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
}

/* 이름·칭호 블록 — 배너 스타일에 따라 바탕만 바뀐다(도형은 같음, 아래 --plain/--stripe) */
.banner {
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 1px 4px;
    margin-bottom: 2px;
    border-radius: var(--lop-radius-world);
}

.banner--plain {
    background-color: rgba(20, 12, 6, 0.55);
}

/* 줄무늬 배너 — 같은 바탕 위에 밝은 줄 하나(위쪽 border)만 더한다 */
.banner--stripe {
    background-color: rgba(20, 12, 6, 0.55);
    border-top-width: 3px;
    border-top-color: var(--lop-primary);
}

.title-label {
    font-size: 9px;
    color: var(--lop-primary);
    -unity-text-align: middle-center;
}

.name-row {
    flex-direction: row;
    align-items: center;
}

.level-label {
    font-size: 9px;
    color: var(--lop-text-on-fill);
    margin-right: 4px;
}

.name-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--lop-text-on-fill);
}

/* 검정 판 → 흰 테두리를 두른 게이지 홈. 월드 위에 뜨는 것이라 얇게 유지한다 */
.hp-bar-bg {
    width: 92%;
    height: 10px;
    background-color: rgba(60, 40, 20, 0.75);
    border-color: var(--lop-outline);
    border-width: var(--lop-border-world);
    border-radius: var(--lop-radius-world);
    padding: 2px;
}

/* 초록은 "적/타인의 남은 체력"이라는 의미를 가진 색이라 유지한다 */
.hp-bar-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(60, 200, 90);
    border-radius: var(--lop-radius-world);
}
