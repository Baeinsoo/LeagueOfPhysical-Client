<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Nameplate.uss" />
    <ui:VisualElement name="nameplate-root" class="nameplate-root">
        <ui:VisualElement name="banner" class="banner">
            <ui:Label name="title-label" class="title-label" />
            <ui:VisualElement name="name-row" class="name-row">
                <ui:Label name="level-label" class="level-label" />
                <ui:Label name="name-label" class="name-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hp-bar-bg" class="hp-bar-bg">
            <ui:VisualElement name="hp-bar-fill" class="hp-bar-fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
