.card {
    flex-grow: 1;
    justify-content: center; align-items: center;
    background-color: rgb(59, 52, 86);
    border-radius: 60px;
    border-width: 5px; border-color: rgba(255, 255, 255, 0.5);
}
/* 굵은 글씨. 바탕과 글씨 색이 비슷해도 읽히게 어두운 테두리를 두른다(시안과 같다). */
.word {
    font-size: 44px;
    -unity-font-definition: url("project://database/Assets/UI/Kit/Fonts/BlackHanSans-Regular%20SDF%20Dynamic.asset?fileID=11400000&guid=da5712ebc3331f74c927a6ca7626e5e2&type=2#BlackHanSans-Regular SDF Dynamic");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(13, 11, 22, 0.95);
    padding: 0; margin: 0;
}
.flash {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    border-radius: 60px; background-color: rgb(255, 255, 255); opacity: 0;
}
