.card {
    flex-grow: 1;
    justify-content: center; align-items: center;
    background-color: rgb(250, 250, 246);
    border-radius: 16px;
    border-width: 5px; border-color: rgb(60, 70, 100);
}
/* 굵은 글씨. 노랑이 흰 판에서 묻히지 않게 어두운 테두리를 두른다. */
.word {
    font-size: 64px;
    -unity-font-definition: url("project://database/Assets/UI/Kit/Fonts/BlackHanSans-Regular%20SDF%20Dynamic.asset?fileID=11400000&guid=da5712ebc3331f74c927a6ca7626e5e2&type=2#BlackHanSans-Regular SDF Dynamic");
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(40, 30, 20, 0.9);
    padding: 0; margin: 0;
}
.dots {
    position: absolute; bottom: 8px; left: 0; right: 0;
    flex-direction: row; justify-content: center; align-items: center;
}
.dot { width: 12px; height: 12px; border-radius: 8px; margin-left: 6px; margin-right: 6px; }
.flash {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    border-radius: 12px; background-color: rgb(255, 255, 255); opacity: 0;
}
