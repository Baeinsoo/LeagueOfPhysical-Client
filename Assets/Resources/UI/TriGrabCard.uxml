<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="TriGrabCard.uss" />
    <!-- 동전 카드 한 장(월드 공간 패널). 진한 바탕 동그라미 안에 색 이름 글자를 글씨 색으로. -->
    <ui:VisualElement name="card" class="card">
        <ui:Label name="word" class="word" text="빨강" />
        <ui:VisualElement name="flash" class="flash" />
    </ui:VisualElement>
</ui:UXML>
