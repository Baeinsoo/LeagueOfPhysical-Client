.archery-pad-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 화면 전체가 조작면이다 — 왼쪽/오른쪽 구분이 없어졌다. */
.pad-surface {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 내려놓기 원 — 누른 자리 아래에 뜬다. 잡고 있는 동안만 View가 켠다.
   자리·크기·모서리 둥글기는 View가 ViewModel 값으로 써 넣는다(여기 적으면 두 곳이 어긋난다).
   손가락이 안에 들어오면 붉어지지만, 들어왔다고 활이 내려가지는 않는다 — 뗄 때만 판정한다. */
.cancel-target {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 24, 26, 0.42);
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.34);
    border-right-color: rgba(255, 255, 255, 0.34);
    border-top-color: rgba(255, 255, 255, 0.34);
    border-bottom-color: rgba(255, 255, 255, 0.34);
}
.cancel-target.is-over {
    background-color: rgba(200, 54, 47, 0.42);
    border-left-color: rgba(232, 110, 92, 0.95);
    border-right-color: rgba(232, 110, 92, 0.95);
    border-top-color: rgba(232, 110, 92, 0.95);
    border-bottom-color: rgba(232, 110, 92, 0.95);
}
.cancel-label {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.6);
}
.cancel-target.is-over .cancel-label {
    color: rgb(255, 225, 220);
}

/* 점수는 화면 위 가운데. 조작을 가리면 안 되므로 입력은 통과시킨다. */
.archery-score {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
    color: rgb(255, 236, 150);
    -unity-font-style: bold;
}
/* 남은 화살 — 점수 바로 아래. 무제한 맵에서는 View가 아예 display:none으로 감춘다. */
.archery-arrows {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(220, 220, 220);
}

/* 조준점 — 화면 한가운데. 당기는 동안만 보인다(ArcheryPadView가 켜고 끈다).
   과녁(노랑)·함정(파랑)·화살(빨강) 어느 것과도 안 겹치게 흰 테두리로 둔다. */
.archery-reticle {
    position: absolute;
    left: 50%; top: 50%;
    width: 44px; height: 44px;
    margin-left: -22px; margin-top: -22px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(255, 255, 255, 0.85);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.archery-reticle-dot {
    width: 5px; height: 5px;
    background-color: rgba(255, 255, 255, 0.95);
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
}


