.archery-pad-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 조작면은 화면 전체다. 왼쪽 절반 = 겨누기, 오른쪽 절반 = 당기기(나누는 일은 코드가 한다). */
.pad-surface {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* ── 끌기 방식의 시위 ──────────────────────────────────────────────
   상자 자체는 크기 0으로 누른 자리에 놓이고(View가 left/top을 써 넣는다), 안의 것들이
   그 점에서 아래로 그려진다. 길이(height/top)는 View가 화면 비율로 써 넣는다. */
.pull-gauge {
    position: absolute;
    display: none;
    width: 0;
    height: 0;
}
.pull-track {
    position: absolute;
    left: 22px;
    top: 0;
    width: 10px;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    background-color: rgba(20, 24, 26, 0.42);
    overflow: hidden;
}
.pull-fill {
    position: absolute;
    left: 0; right: 0; top: 0;
    background-color: rgba(255, 236, 150, 0.75);
}
.pull-gauge.is-full .pull-fill {
    background-color: rgb(255, 214, 90);
}
/* 이만큼 끌어야 활이 올라온다는 표시. */
.pull-threshold {
    position: absolute;
    left: -16px;
    width: 32px;
    height: 2px;
    background-color: rgba(255, 255, 255, 0.45);
}
/* 누른 자리에서 손가락까지의 시위. 당기는 중엔 밝아진다. */
.pull-string {
    position: absolute;
    left: -1.5px;
    top: 0;
    width: 3px;
    background-color: rgba(255, 255, 255, 0.4);
}
.pull-gauge.is-drawing .pull-string {
    background-color: rgba(255, 236, 150, 0.95);
}
.pull-anchor {
    position: absolute;
    left: -7px; top: -7px;
    width: 14px; height: 14px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
    border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
    background-color: rgba(255, 255, 255, 0.55);
}
.pull-knob {
    position: absolute;
    left: -18px;
    width: 36px; height: 36px;
    margin-top: -18px;
    border-top-left-radius: 18px; border-top-right-radius: 18px;
    border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.7);
    border-right-color: rgba(255, 255, 255, 0.7);
    border-top-color: rgba(255, 255, 255, 0.7);
    border-bottom-color: rgba(255, 255, 255, 0.7);
    background-color: rgba(255, 255, 255, 0.12);
}
.pull-gauge.is-drawing .pull-knob {
    border-left-color: rgb(255, 236, 150);
    border-right-color: rgb(255, 236, 150);
    border-top-color: rgb(255, 236, 150);
    border-bottom-color: rgb(255, 236, 150);
}

/* 당기기 방식 토글 — 왼쪽 위 작은 단추. 개발 빌드·에디터에서만 보인다. */
.draw-style-toggle {
    position: absolute;
    top: 24px; left: 24px;
    padding-left: 14px; padding-right: 14px;
    padding-top: 6px; padding-bottom: 6px;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.85);
    background-color: rgba(20, 24, 26, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.3);
    border-right-color: rgba(255, 255, 255, 0.3);
    border-top-color: rgba(255, 255, 255, 0.3);
    border-bottom-color: rgba(255, 255, 255, 0.3);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}

/* 내려놓기 원 — 누른 자리 아래에 뜬다. 잡고 있는 동안만 View가 켠다.
   자리·크기·모서리 둥글기는 View가 ViewModel 값으로 써 넣는다(여기 적으면 두 곳이 어긋난다).
   손가락이 안에 들어오면 붉어지지만, 들어왔다고 활이 내려가지는 않는다 — 뗄 때만 판정한다. */
.cancel-target {
    position: absolute;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 24, 26, 0.42);
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.34);
    border-right-color: rgba(255, 255, 255, 0.34);
    border-top-color: rgba(255, 255, 255, 0.34);
    border-bottom-color: rgba(255, 255, 255, 0.34);
}
.cancel-target.is-over {
    background-color: rgba(200, 54, 47, 0.42);
    border-left-color: rgba(232, 110, 92, 0.95);
    border-right-color: rgba(232, 110, 92, 0.95);
    border-top-color: rgba(232, 110, 92, 0.95);
    border-bottom-color: rgba(232, 110, 92, 0.95);
}
.cancel-label {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.6);
}
.cancel-target.is-over .cancel-label {
    color: rgb(255, 225, 220);
}

/* 점수는 화면 위 가운데. 조작을 가리면 안 되므로 입력은 통과시킨다. */
.archery-score {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
    color: rgb(255, 236, 150);
    -unity-font-style: bold;
}
/* 남은 화살 — 점수 바로 아래. 무제한 맵에서는 View가 아예 display:none으로 감춘다. */
.archery-arrows {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(220, 220, 220);
}

/* 조준점 — 화면 한가운데. 당기는 동안만 보인다(ArcheryPadView가 켜고 끈다).
   과녁(노랑)·함정(파랑)·화살(빨강) 어느 것과도 안 겹치게 흰 테두리로 둔다. */
.archery-reticle {
    position: absolute;
    left: 50%; top: 50%;
    width: 44px; height: 44px;
    margin-left: -22px; margin-top: -22px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(255, 255, 255, 0.85);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.archery-reticle-dot {
    width: 5px; height: 5px;
    background-color: rgba(255, 255, 255, 0.95);
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
}

/* ── 착탄 기록판 ───────────────────────────────────────────────────
   화면 오른쪽 위. 과녁 면을 1로 본 좌표를 그대로 그리므로, 12m(40cm)든 90m(122cm)든
   같은 그림 위에서 비교된다. 띠 원과 점은 View가 코드로 만들어 넣는다. */
.impact-plot {
    position: absolute;
    top: 24px; right: 24px;
    width: 200px; height: 224px;
    align-items: center;
}
.plot-face {
    width: 200px; height: 200px;
    border-top-left-radius: 100px; border-top-right-radius: 100px;
    border-bottom-left-radius: 100px; border-bottom-right-radius: 100px;
    background-color: rgba(12, 16, 20, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
}
.plot-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
}
/* 띠 하나(동심원). View가 비율대로 크기를 정한다. */
.plot-band {
    position: absolute;
}
/* 꽂힌 자리 하나. 마지막 발만 밝게 켠다 — 방금 쏜 것이 어디였는지가 읽혀야 고칠 수 있다. */
.plot-dot {
    position: absolute;
    width: 9px; height: 9px;
    margin-left: -4.5px; margin-top: -4.5px;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    background-color: rgba(255, 255, 255, 0.45);
}
.plot-dot.is-latest {
    width: 13px; height: 13px;
    margin-left: -6.5px; margin-top: -6.5px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
    border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
    background-color: rgb(255, 255, 255);
}

/* ── 발당 점수 ─────────────────────────────────────────────────── */
.hit-popups {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
.hit-popup {
    position: absolute;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 236, 150);
    -unity-text-align: middle-center;
    width: 140px;
    margin-left: -70px;
}

