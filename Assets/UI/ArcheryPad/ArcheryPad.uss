.archery-pad-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.pad-half {
    position: absolute;
    top: 0; bottom: 0;
    width: 50%;
}

.pad-left { left: 0; }
.pad-right { right: 0; }

/* 점수는 화면 위 가운데. 조작을 가리면 안 되므로 입력은 통과시킨다. */
.archery-score {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
    color: rgb(255, 236, 150);
    -unity-font-style: bold;
}
/* 남은 화살 — 점수 바로 아래. 무제한 맵에서는 View가 아예 display:none으로 감춘다. */
.archery-arrows {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(220, 220, 220);
}

/* 조준점 — 화면 한가운데. 당기는 동안만 보인다(ArcheryPadView가 켜고 끈다).
   과녁(노랑)·함정(파랑)·화살(빨강) 어느 것과도 안 겹치게 흰 테두리로 둔다. */
.archery-reticle {
    position: absolute;
    left: 50%; top: 50%;
    width: 44px; height: 44px;
    margin-left: -22px; margin-top: -22px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(255, 255, 255, 0.85);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.archery-reticle-dot {
    width: 5px; height: 5px;
    background-color: rgba(255, 255, 255, 0.95);
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
}

/* 당김 게이지 — 손가락을 댄 자리에 뜬다. 크기는 View가 화면 크기에 맞춰 코드로 정한다
   (완전 당김 거리가 화면 비율로 정의돼 있어서 USS에 숫자로 못 박는다). */
.draw-gauge {
    position: absolute;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.35);
    border-right-color: rgba(255, 255, 255, 0.35);
    border-top-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.35);
    align-items: center;
    justify-content: center;
}

/* 이 원 안으로 돌아오면 취소다 — 그 경계가 보여야 되돌릴지 말지를 고를 수 있다. */
.draw-threshold {
    position: absolute;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 190, 120, 0.75);
    border-right-color: rgba(255, 190, 120, 0.75);
    border-top-color: rgba(255, 190, 120, 0.75);
    border-bottom-color: rgba(255, 190, 120, 0.75);
}

/* 지금 손가락 자리. 임계치를 넘으면 밝아진다. */
.draw-knob {
    position: absolute;
    width: 46px; height: 46px;
    border-top-left-radius: 23px; border-top-right-radius: 23px;
    border-bottom-left-radius: 23px; border-bottom-right-radius: 23px;
    background-color: rgba(255, 255, 255, 0.55);
}

/* 활 조준기(사이트) — 거리마다 눈금 하나. 십자선 아래로 내려갈수록 먼 거리다.
   위치는 View가 탄도 계산으로 정한다(USS는 모양만). 실제 양궁의 사이트 핀과 같은 것이라,
   "어느 핀을 쓸지"와 "그 핀을 과녁에 붙들고 있기"는 여전히 쏘는 사람 몫이다. */
.archery-sight-pin {
    position: absolute;
    left: 50%;
    margin-left: -17px;
    width: 34px;
    height: 2px;
    background-color: rgba(255, 236, 150, 0.7);
}

/* 거리 숫자는 눈금 오른쪽에. 눈금 자체를 가리지 않는다. */
.archery-sight-pin-label {
    position: absolute;
    left: 42px;
    top: -8px;
    font-size: 13px;
    color: rgba(255, 236, 150, 0.75);
}
