.archery-pad-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 조작면은 화면 전체다. 걷기 스틱이 그 위에 얹혀 왼쪽 아래 구석만 가져간다 —
   그래서 겨누는 것은 나머지 어디서든 시작할 수 있다. */
.pad-surface {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 걷기 스틱이 사는 구석. 오른손 엄지가 겨누는 동안 왼손 엄지가 여기를 쓴다.
   취소 버튼이 이 구석 안에 서 있어 그 원 자리만은 취소 버튼이 가져간다. */
.move-area {
    position: absolute;
    left: 0; bottom: 0;
    width: 38%;
    height: 55%;
}

/* 누른 자리에 떠오른다(떠다니는 스틱) — 자리는 View가 써 넣는다. */
.move-bg {
    position: absolute;
    visibility: hidden;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.16);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
}

.move-handle {
    position: absolute;
    left: 55px; top: 55px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.7);
}

/* 활 버튼 — 오른쪽. 자리·크기·둥글기는 View가 화면에 맞춰 써 넣는다.
   바깥(.bow-button-hit)은 투명한 누르는 자리, 안쪽(.bow-button)이 보이는 원이다. */
.bow-button-hit {
    position: absolute;
    align-items: center;
    justify-content: center;
}
.bow-button {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.28);
    border-left-width: 3px; border-right-width: 3px;
    border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(255, 255, 255, 0.85);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.85);
}
/* 쥐고 있는 동안 노랗게 켜진다. 시위가 걸리면 더 진해진다 — 지금 떼면 나간다는 뜻이다. */
.bow-button.is-drawing {
    background-color: rgba(255, 225, 77, 0.35);
}
.bow-button.is-armed {
    background-color: rgba(255, 225, 77, 0.55);
}
.bow-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 취소 버튼 — 왼쪽 아래. 자리·크기·둥글기는 View가 화면에 맞춰 써 넣는다.
   안 당길 땐 display:none으로 아예 없고, 당기는 동안만 보이며, 활 손가락이 위에 오면 붉어진다.
   위에 왔다고 활이 내려가지는 않는다 — 뗄 때만 판정한다. */
.cancel-button-hit {
    position: absolute;
    align-items: center;
    justify-content: center;
}
.cancel-button {
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 24, 26, 0.42);
    border-left-width: 3px; border-right-width: 3px;
    border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.6);
    border-right-color: rgba(255, 255, 255, 0.6);
    border-top-color: rgba(255, 255, 255, 0.6);
    border-bottom-color: rgba(255, 255, 255, 0.6);
}
.cancel-button.is-over {
    background-color: rgba(200, 54, 47, 0.55);
    border-left-color: rgba(232, 110, 92, 0.95);
    border-right-color: rgba(232, 110, 92, 0.95);
    border-top-color: rgba(232, 110, 92, 0.95);
    border-bottom-color: rgba(232, 110, 92, 0.95);
}
.cancel-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.cancel-button.is-over .cancel-label {
    color: rgb(255, 225, 220);
}

/* 점수는 화면 위 가운데. 조작을 가리면 안 되므로 입력은 통과시킨다. */
.archery-score {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
    color: rgb(255, 236, 150);
    -unity-font-style: bold;
}
/* 남은 화살 — 점수 바로 아래. 무제한 맵에서는 View가 아예 display:none으로 감춘다. */
.archery-arrows {
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: rgb(220, 220, 220);
}

/* 조준점 — 화면 한가운데. 당기는 동안만 보인다(ArcheryPadView가 켜고 끈다).
   과녁(노랑)·함정(파랑)·화살(빨강) 어느 것과도 안 겹치게 흰 테두리로 둔다. */
.archery-reticle {
    position: absolute;
    left: 50%; top: 50%;
    width: 44px; height: 44px;
    margin-left: -22px; margin-top: -22px;
    border-left-width: 2px; border-right-width: 2px;
    border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.85);
    border-right-color: rgba(255, 255, 255, 0.85);
    border-top-color: rgba(255, 255, 255, 0.85);
    border-bottom-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    align-items: center;
    justify-content: center;
}

.archery-reticle-dot {
    width: 5px; height: 5px;
    background-color: rgba(255, 255, 255, 0.95);
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
}

/* ── 착탄 기록판 ───────────────────────────────────────────────────
   화면 오른쪽 위. 과녁 면을 1로 본 좌표를 그대로 그리므로, 12m(40cm)든 90m(122cm)든
   같은 그림 위에서 비교된다. 띠 원과 점은 View가 코드로 만들어 넣는다. */
.impact-plot {
    position: absolute;
    top: 24px; right: 24px;
    width: 200px; height: 224px;
    align-items: center;
}
.plot-face {
    width: 200px; height: 200px;
    border-top-left-radius: 100px; border-top-right-radius: 100px;
    border-bottom-left-radius: 100px; border-bottom-right-radius: 100px;
    background-color: rgba(12, 16, 20, 0.55);
    border-left-width: 1px; border-right-width: 1px;
    border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.25);
    border-right-color: rgba(255, 255, 255, 0.25);
    border-top-color: rgba(255, 255, 255, 0.25);
    border-bottom-color: rgba(255, 255, 255, 0.25);
}
.plot-label {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
}
/* 띠 하나(동심원). View가 비율대로 크기를 정한다. */
.plot-band {
    position: absolute;
}
/* 꽂힌 자리 하나. 마지막 발만 밝게 켠다 — 방금 쏜 것이 어디였는지가 읽혀야 고칠 수 있다. */
.plot-dot {
    position: absolute;
    width: 9px; height: 9px;
    margin-left: -4.5px; margin-top: -4.5px;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    background-color: rgba(255, 255, 255, 0.45);
}
.plot-dot.is-latest {
    width: 13px; height: 13px;
    margin-left: -6.5px; margin-top: -6.5px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
    border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;
    background-color: rgb(255, 255, 255);
}

/* ── 발당 점수 ─────────────────────────────────────────────────── */
.hit-popups {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
.hit-popup {
    position: absolute;
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 236, 150);
    -unity-text-align: middle-center;
    width: 140px;
    margin-left: -70px;
}


/* 개발 빌드 전용: 조준 가속 세기 버튼. 작게, 왼쪽 위 구석에. */
.aim-accel-toggle {
    position: absolute;
    left: 12px; top: 12px;
    margin: 0;
    padding: 4px 10px;
    font-size: 16px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 0;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
