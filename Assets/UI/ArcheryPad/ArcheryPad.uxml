<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ArcheryPad.uss" />
    <ui:VisualElement name="archery-pad-root" class="archery-pad-root">
        <!-- 조작면. 끌면 겨누기만 한다 — 여기서는 활을 들지도 쏘지도 않는다.
             화면 전체를 덮되, 아래 걷기 스틱·활 버튼이 *그 위에* 얹혀 자기 자리만 가져간다. -->
        <ui:VisualElement name="surface" class="pad-surface" />
        <!-- 걷기 스틱: 왼쪽 아래. 누른 자리에 떠오르는 떠다니는 스틱이다.
             조작면보다 **뒤에** 적어야 위로 올라와 그 구석의 손가락을 먼저 받는다. -->
        <ui:VisualElement name="move-area" class="move-area">
            <ui:VisualElement name="move-bg" class="move-bg" picking-mode="Ignore">
                <ui:VisualElement name="move-handle" class="move-handle" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 활 버튼: 기본은 오른쪽(안전 영역의 가로 80%·세로 62%). 누르면 활이 올라오고, 쥔 채 끌면 겨누고, 떼면 쏜다.
             자리·크기는 ArcheryButtonLayout이 정하고 ArcheryPadView가 놓는다. 바깥이 누르는 자리, 안쪽이 보이는 원이다. -->
        <ui:VisualElement name="bow-button" class="bow-button-hit">
            <ui:VisualElement name="bow-face" class="bow-button" picking-mode="Ignore">
                <ui:VisualElement name="bow-icon" class="bow-icon" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 시위 풀기 버튼: 기본은 왼쪽 아래(가로 12%·세로 74%). 활을 든 동안만 보인다(View가 display:none으로 감춘다).
             당기는 중에 다른 손가락으로 누르거나, 활 손가락을 끌어와 그 위에서 떼면 안 쏘고 내려놓는다.
             안 당길 땐 안 보이고, 그 자리에서 시작한 손가락은 평범한 화면 손가락처럼 겨눈다
             (판정은 ArcheryPointerRouter.Down이 한다). 누르는 자리는 안 보여도 그대로 있으므로
             걷기 스틱 구석과 겹쳐도 그보다 **뒤에** 적어 이 자리의 손가락을 먼저 받는다. -->
        <ui:VisualElement name="cancel-button" class="cancel-button-hit">
            <ui:VisualElement name="cancel-face" class="cancel-button" picking-mode="Ignore">
                <ui:VisualElement name="cancel-icon" class="cancel-icon" picking-mode="Ignore" />
                <ui:Label name="cancel-label" class="cancel-label" text="시위 풀기" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 옮기기 손잡이: 각 버튼 오른쪽 위 가장자리. 늘 보인다 — 시위 풀기 버튼이 숨어 있어도 그 손잡이는 있다.
             끌면 버튼이 따라오고, 움직이지 않고 1초 누르면 기본 자리로 돌아간다. 당기는 중엔 안 잡힌다.
             버튼보다 **뒤에** 적어 위에 올라온다(판정도 손잡이가 먼저다 — ArcheryButtonLayout.HitTest). -->
        <ui:VisualElement name="bow-handle" class="layout-handle-hit">
            <ui:VisualElement name="bow-handle-face" class="layout-handle" picking-mode="Ignore">
                <ui:VisualElement class="layout-handle-icon" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="cancel-handle" class="layout-handle-hit">
            <ui:VisualElement name="cancel-handle-face" class="layout-handle" picking-mode="Ignore">
                <ui:VisualElement class="layout-handle-icon" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 조준점: 화면 한가운데, 시위가 걸린 동안만 뜬다. 바깥 원 + 가운데 점. -->
        <ui:VisualElement name="reticle" class="archery-reticle" picking-mode="Ignore">
            <ui:VisualElement name="reticle-dot" class="archery-reticle-dot" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 착탄 기록판: 이 자리에서 내 화살이 과녁 어디에 꽂혔나. 자리가 바뀌면 지워진다.
             90m 과녁은 화면에서 지름 38px이라 눈으로는 착탄점을 못 읽는다 — 그걸 크게 보여 준다.
             띠는 View가 ArcheryPadViewModel의 비율에서 그린다(점수 데이터와 한 값에서 나온다). -->
        <ui:VisualElement name="impact-plot" class="impact-plot" picking-mode="Ignore">
            <ui:VisualElement name="plot-face" class="plot-face" picking-mode="Ignore" />
            <ui:Label name="plot-label" class="plot-label" text="" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 발당 점수가 떠오르는 자리. 맞은 과녁을 화면에 투영한 곳에서 시작한다. -->
        <ui:VisualElement name="hit-popups" class="hit-popups" picking-mode="Ignore" />
        <ui:Label name="score" class="archery-score" text="0" picking-mode="Ignore" />
        <ui:Label name="arrows" class="archery-arrows" text="" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
