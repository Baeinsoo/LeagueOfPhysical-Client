.shootoff-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.shootoff-flash {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(255, 255, 255);
    opacity: 0;
}
.shootoff-bull-popups {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
.shootoff-bull-popup {
    position: absolute;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(255, 255, 255);
    width: 160px;
    margin-left: -80px;
}

/* 라운드 · 남은 시간 · 바람. 조작 패드의 점수(위 24px)·남은 화살(72px) 아래에 놓는다. */
.shootoff-top {
    position: absolute;
    top: 108px;
    left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.shootoff-round {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 236, 150);
    margin-right: 16px;
}
.shootoff-time {
    width: 220px;
    height: 10px;
    background-color: rgba(12, 16, 20, 0.55);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    overflow: hidden;
}
.shootoff-time-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 236, 150);
}
.shootoff-wind {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    min-width: 120px;
}
.shootoff-wind-arrow {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.shootoff-wind-text {
    font-size: 20px;
    color: rgb(220, 220, 220);
    margin-left: 6px;
}

/* 해설 자막 — 중계 자막처럼 한 줄. 비었으면 View가 감춘다. */
.shootoff-caption {
    position: absolute;
    top: 156px;
    align-self: center;
    padding: 8px 22px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(12, 16, 20, 0.62);
    border-top-left-radius: 24px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
}

/* 라운드 결과 — 위쪽 가운데 반투명 판. 아래쪽 캐릭터 리액션이 보이게 화면 전체를 덮지 않는다. */
.shootoff-result {
    position: absolute;
    top: 216px;
    align-self: center;
    width: 720px;
    padding: 14px 20px;
    background-color: rgba(12, 16, 20, 0.72);
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;
}
.shootoff-result-headline {
    font-size: 34px;
    -unity-font-style: bold;
    color: rgb(255, 194, 61);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
}
.shootoff-result-body {
    flex-direction: row;
    align-items: center;
}
.shootoff-result-face {
    width: 300px;
    height: 300px;
}
.shootoff-result-list {
    flex-grow: 1;
    margin-left: 24px;
}
.shootoff-result-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}
.shootoff-result-dot {
    width: 16px;
    height: 16px;
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
    margin-right: 10px;
}
.shootoff-result-text {
    font-size: 24px;
    color: rgb(240, 236, 228);
    margin-right: 14px;
}
.shootoff-result-row.is-me .shootoff-result-text {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* 라운드 소개 — 자리가 바뀌는 순간 화면을 덮는다(투명도는 View가 매 프레임 준다). */
.shootoff-intro {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgb(20, 24, 32);
    align-items: center;
    justify-content: center;
    opacity: 0;
    display: none;
}
.shootoff-intro-title {
    font-size: 64px;
    -unity-font-style: bold;
    color: rgb(255, 236, 150);
    -unity-text-align: middle-center;
}
.shootoff-intro-detail {
    font-size: 30px;
    color: rgb(235, 235, 235);
    -unity-text-align: middle-center;
    margin-top: 12px;
}

/* 정색 컷인(슬라이스 3) — 띠는 -7도, 안쪽은 +7도로 되돌려 똑바로. 얼굴 너비는 코드가 높이에 맞춘다(USS에 aspect-ratio가 없다). */
.cutin { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
.cutin-band {
    position: absolute; left: -8%; right: -8%; top: 22%; height: 56%;
    rotate: -7deg; background-color: rgb(14, 11, 18); overflow: hidden;
    border-top-width: 6px; border-bottom-width: 6px; border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);
}
.cutin-lines { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.cutin-inner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; rotate: 7deg; }
.cutin-face { position: absolute; left: 14%; top: -8%; height: 116%; }
.cutin-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.cutin-words { position: absolute; right: 12%; top: 30%; rotate: -4deg; align-items: flex-start; }
.cutin-shout {
    -unity-font-definition: url("project://database/Assets/UI/Theme/Fonts/BlackHanSans%20CutIn.asset");
    font-size: 88px; color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(14, 11, 18);
    text-shadow: 6px 6px 0 rgb(255, 79, 94);
}
.cutin-name {
    -unity-font-definition: url("project://database/Assets/UI/Theme/Fonts/BlackHanSans%20CutIn.asset");
    font-size: 26px; color: rgb(243, 239, 230); letter-spacing: 3px; margin-top: 6px;
}
