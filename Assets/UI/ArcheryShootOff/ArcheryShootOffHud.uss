.shootoff-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

/* 라운드 · 남은 시간 · 바람. 조작 패드의 점수(위 24px)·남은 화살(72px) 아래에 놓는다. */
.shootoff-top {
    position: absolute;
    top: 108px;
    left: 0; right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.shootoff-round {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 236, 150);
    margin-right: 16px;
}
.shootoff-time {
    width: 220px;
    height: 10px;
    background-color: rgba(12, 16, 20, 0.55);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    overflow: hidden;
}
.shootoff-time-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(255, 236, 150);
}
.shootoff-wind {
    flex-direction: row;
    align-items: center;
    margin-left: 16px;
    min-width: 120px;
}
.shootoff-wind-arrow {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
.shootoff-wind-text {
    font-size: 20px;
    color: rgb(220, 220, 220);
    margin-left: 6px;
}

/* 해설 자막 — 중계 자막처럼 한 줄. 비었으면 View가 감춘다. */
.shootoff-caption {
    position: absolute;
    top: 156px;
    align-self: center;
    padding: 8px 22px;
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(12, 16, 20, 0.62);
    border-top-left-radius: 24px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
}

/* 라운드 결과 목록 — 화면 오른쪽 가운데, 착탄 기록판 아래. */
.shootoff-result {
    position: absolute;
    right: 24px;
    top: 50%;
    min-width: 240px;
    padding: 10px 14px;
    background-color: rgba(12, 16, 20, 0.62);
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
.shootoff-result-row {
    font-size: 20px;
    color: rgb(230, 230, 230);
    margin-top: 2px;
    margin-bottom: 2px;
}
.shootoff-result-row.is-first {
    color: rgb(255, 236, 150);
    -unity-font-style: bold;
}
