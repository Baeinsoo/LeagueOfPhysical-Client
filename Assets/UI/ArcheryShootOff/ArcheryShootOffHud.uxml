<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ArcheryShootOffHud.uss" />
    <!-- 보여 주기만 한다 — 아래 조작 패드의 입력을 막지 않게 전부 picking-mode="Ignore". -->
    <ui:VisualElement name="shootoff-root" class="shootoff-root" picking-mode="Ignore">
        <ui:VisualElement name="flash" class="shootoff-flash" picking-mode="Ignore" />
        <ui:VisualElement class="shootoff-top" picking-mode="Ignore">
            <ui:Label name="round" class="shootoff-round" picking-mode="Ignore" />
            <ui:VisualElement class="shootoff-time" picking-mode="Ignore">
                <ui:VisualElement name="time-fill" class="shootoff-time-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="wind" class="shootoff-wind" picking-mode="Ignore">
                <ui:Label name="wind-arrow" class="shootoff-wind-arrow" picking-mode="Ignore" />
                <ui:Label name="wind-text" class="shootoff-wind-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="caption" class="shootoff-caption" picking-mode="Ignore" />
        <ui:VisualElement name="result" class="shootoff-result" picking-mode="Ignore">
            <ui:Label name="result-headline" class="shootoff-result-headline" picking-mode="Ignore" />
            <ui:VisualElement class="shootoff-result-body" picking-mode="Ignore">
                <ui:VisualElement name="result-face" class="shootoff-result-face" picking-mode="Ignore" />
                <ui:VisualElement name="result-list" class="shootoff-result-list" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 라운드 소개 — 자리가 바뀌는 순간 화면 전체를 덮는다. 자막·결과판 위에 온다. -->
        <ui:VisualElement name="intro" class="shootoff-intro" picking-mode="Ignore">
            <ui:Label name="intro-title" class="shootoff-intro-title" picking-mode="Ignore" />
            <ui:Label name="intro-detail" class="shootoff-intro-detail" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 정색 컷인 — 결과 순간 0.95초. 띠는 기울어져 있고 안쪽 내용은 되돌려 똑바로 선다. -->
        <ui:VisualElement name="cutin" class="cutin" picking-mode="Ignore">
            <ui:VisualElement name="cutin-band" class="cutin-band" picking-mode="Ignore">
                <ui:VisualElement name="cutin-lines" class="cutin-lines" picking-mode="Ignore" />
                <ui:VisualElement class="cutin-inner" picking-mode="Ignore">
                    <ui:VisualElement name="cutin-face" class="cutin-face" picking-mode="Ignore">
                        <ui:VisualElement name="cutin-skin" class="cutin-layer" picking-mode="Ignore" />
                        <ui:VisualElement name="cutin-hair" class="cutin-layer" picking-mode="Ignore" />
                        <ui:VisualElement name="cutin-ink" class="cutin-layer" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="cutin-words" picking-mode="Ignore">
                        <ui:Label name="cutin-shout" class="cutin-shout" picking-mode="Ignore" />
                        <ui:Label name="cutin-name" class="cutin-name" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bull-popups" class="shootoff-bull-popups" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
