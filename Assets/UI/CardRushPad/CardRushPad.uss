.card-rush-root {
    flex-grow: 1;
}

/* 화면 전체가 입력면 — 손가락마다 PointerDownEvent가 따로 와서 멀티터치가 그대로 된다. */
.card-rush-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 연속 정타 — 화면 아래 가운데, 바탕 없음(카드는 머리 위로 옮겼다). 통통 튀는 건 코드가 scale로 한다. */
.card-rush-streak {
    position: absolute;
    bottom: 3%;
    left: 0;
    right: 0;
    font-size: 40px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-center;
    transform-origin: center;
}
