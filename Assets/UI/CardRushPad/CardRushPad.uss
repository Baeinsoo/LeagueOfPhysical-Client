.card-rush-root {
    flex-grow: 1;
}

/* 화면 전체가 입력면 — 손가락마다 PointerDownEvent가 따로 와서 멀티터치가 그대로 된다. */
.card-rush-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 큰 카드 — 화면 아래 가운데, 폭 28%(spec §7.3). 1920 기준 폭 약 538px, 높이는 카드 비율. */
.card-rush-card {
    position: absolute;
    left: 36%;
    width: 28%;
    bottom: 120px;
    height: 300px;
    border-radius: 28px;
    border-width: 6px;
    border-color: rgba(17, 14, 12, 0.6);
    justify-content: center;
    align-items: center;
    background-color: rgb(120, 120, 120);
    transform-origin: center;
}

.card-rush-card-glyph {
    font-size: 140px;
    color: rgba(17, 14, 12, 0.85);
    -unity-text-align: middle-center;
}

/* 뒷면 — 색이 아니라 중립 무늬(색맹 대응과 같은 이유로 색만으로 "앞/뒤"를 구분하지 않는다). */
.card-rush-card-back {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.card-rush-card--back .card-rush-card-back {
    display: flex;
}

.card-rush-card--back .card-rush-card-glyph {
    display: none;
}

.card-rush-card--back {
    background-color: rgb(58, 54, 50);
}

/* 마름모 셋 — 뒷면의 무늬. 가운데가 가장 크다. */
.card-rush-card-back-mark {
    width: 54px;
    height: 54px;
    rotate: 45deg;
    border-width: 4px;
    border-color: rgba(243, 235, 226, 0.35);
}

/* 다음 칩 — 카드 바로 위, 가운데. 지금 요구 색 하나(크게) + 그다음 둘(작게)(spec §7.3). */
.card-rush-next {
    position: absolute;
    left: 50%;
    bottom: 440px;
    width: 220px;
    margin-left: -110px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.card-rush-chip {
    width: 56px;
    height: 56px;
    margin-left: 6px;
    margin-right: 6px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgba(17, 14, 12, 0.6);
    justify-content: center;
    align-items: center;
    background-color: rgb(120, 120, 120);
}

.card-rush-chip Label {
    font-size: 30px;
    color: rgba(17, 14, 12, 0.85);
    -unity-text-align: middle-center;
}

.card-rush-chip--now {
    width: 76px;
    height: 76px;
    border-width: 4px;
    border-color: rgb(243, 235, 226);
}

.card-rush-chip--now Label {
    font-size: 40px;
}

/* 연속 정타 — 카드 옆(spec §7.3). 통통 튀는 건 코드가 scale로 한다. */
.card-rush-streak {
    position: absolute;
    left: 66%;
    bottom: 200px;
    font-size: 36px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-center;
    transform-origin: center;
}
