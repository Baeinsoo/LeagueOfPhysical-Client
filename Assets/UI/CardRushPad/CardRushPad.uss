.card-rush-root {
    flex-grow: 1;
}

/* 카드 버튼(4.2차) — 오른쪽 아래에 크게, 엄지가 닿는 자리. 그림은 코드가 그린다(CardRushCardButton). */
.card-rush-button {
    position: absolute;
    right: 3%;
    bottom: 5%;
    width: 300px;
    height: 300px;
}

/* 연속 무사 통과("무사 N") — 화면 아래 가운데, 작은 어두운 알약 바탕(베이지 바닥 위 대비, 리뷰 L3). 카드는 머리 위로 옮겼다.
   통통 튀는 건 코드가 scale로 한다. 탭은 카드 버튼만 받는다(picking-mode Ignore). */
.card-rush-streak {
    position: absolute;
    bottom: 3%;
    left: 50%;
    translate: -50% 0;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-radius: 28px;
    background-color: rgba(28, 22, 16, 0.45);
    font-size: 40px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-center;
    transform-origin: center;
}

/* 조작 안내(4차 spec §4) — 무사 글 위, 더 작고 흐리게. 탭은 카드 버튼만 받는다. */
.card-rush-hint {
    position: absolute;
    bottom: 12%;
    left: 50%;
    translate: -50% 0;
    font-size: 30px;
    color: rgba(243, 235, 226, 0.85);
    -unity-text-align: middle-center;
    background-color: rgba(28, 22, 16, 0.35);
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-radius: 22px;
}
