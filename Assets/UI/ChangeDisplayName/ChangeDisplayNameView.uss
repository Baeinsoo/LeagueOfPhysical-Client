.cdn-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.cdn-card {
    width: 680px;
}

.cdn-title {
    font-size: 48px;
    margin-bottom: 24px;
}

.cdn-input {
    height: 96px;
    font-size: 34px;
    margin-bottom: 16px;
}

.cdn-hint {
    font-size: 24px;
    opacity: 0.7;
    margin-bottom: 8px;
}

.cdn-message {
    font-size: 26px;
    color: rgb(255, 120, 120);
    margin-bottom: 8px;
}

.cdn-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 24px;
}

.cdn-button {
    height: 100px;
    font-size: 34px;
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 8px;
}
