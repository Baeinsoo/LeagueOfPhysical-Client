<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lop="LOP.UI">
    <!-- 이름 바꾸기 모달(키트). 요소 이름은 ChangeDisplayNameView 코드가 찾는 그대로. -->
    <ui:VisualElement name="cdn-root" class="kit cdn-root">
        <ui:VisualElement name="cdn-card" class="kit-panel cdn-card">
            <ui:VisualElement class="kit-panel__back" />
            <ui:VisualElement class="kit-panel__face cdn-face">
                <ui:Label text="이름 바꾸기" class="kit-title cdn-title" />
                <ui:TextField name="cdn-input" class="cdn-input" />
                <ui:Label text="2~12자, 공백 없이. 이름은 다른 사람과 겹쳐도 됩니다." class="cdn-hint" />
                <ui:Label name="cdn-message" text="" class="cdn-message" style="display: none;" />
                <ui:VisualElement name="cdn-actions" class="cdn-actions">
                    <ui:Button name="cdn-cancel" class="kit-press kit-btn cdn-button cdn-cancel"><lop:StickerElement><ui:Label text="취소" class="kit-btn__label" /></lop:StickerElement></ui:Button>
                    <ui:Button name="cdn-confirm" class="kit-press kit-btn kit-btn--primary cdn-button"><lop:StickerElement><ui:Label text="확인" class="kit-btn__label" /></lop:StickerElement></ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
