.hud-root {
    flex-grow: 1;
}

/* 배경·테두리색·라운드는 .card(Theme.uss)가 담당한다. 여기엔 위치·크기만 남긴다 */
.hud-panel {
    position: absolute;
    top: 24px;
    left: 24px;
    width: 460px;
    padding: 18px;
    border-width: var(--lop-border-m);
}

.level-text {
    color: var(--lop-text);
    font-size: 28px;
    margin-bottom: 12px;
}

.bar {
    height: 34px;
    margin-bottom: 10px;

    /* 게이지 홈. 흰 테두리를 둘러 톤을 맞춘다 */
    background-color: var(--lop-surface-sunken);
    border-color: var(--lop-outline);
    border-width: var(--lop-border-xs);
    border-radius: var(--lop-radius-s);
    justify-content: center;
    overflow: hidden;
}

.bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    border-radius: var(--lop-radius-s);
}

.hp-fill {
    background-color: rgb(210, 60, 60);
}

.mp-fill {
    background-color: rgb(60, 110, 220);
}

.exp-fill {
    background-color: rgb(220, 190, 60);
}

/* 채움 색 위에 얹히는 글자라 테두리로 읽히게 한다 */
.bar-text {
    -unity-text-align: middle-center;
    color: var(--lop-text-on-fill);
    font-size: 20px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(60, 30, 10, 0.9);
}
