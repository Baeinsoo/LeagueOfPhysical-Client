.debug-hud-root {
    flex-grow: 1;
}

.debug-panel {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 380px;
    padding: 8px 12px;
    /* 하늘 배경이 밝아서 반투명하면 글자가 묻힌다 — 진하게 깐다. */
    background-color: rgba(10, 10, 14, 0.78);
    border-radius: 6px;
}

.debug-text {
    color: rgb(180, 230, 180);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* 시뮬 정지 — 놓치면 안 되는 한 줄이라 다른 값들과 다르게 보인다 */
.debug-text--faulted {
    color: rgb(255, 92, 92);
    -unity-font-style: bold;
}

/* 켜고 끄는 손잡이. 늘 보인다 — 모바일엔 F1이 없다.
   손가락으로 누를 수 있어야 하므로 44px 이상(애플 44pt·구글 48dp가 터치 타깃 최소치).
   평소엔 눈에 안 걸리게 흐리고, 누를 때만 또렷해진다. */
.debug-toggle {
    position: absolute;
    top: 8px; left: 8px;
    min-width: 88px; height: 44px;
    padding: 0 12px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    background-color: rgba(10, 10, 14, 0.35);
    border-left-width: 0; border-right-width: 0;
    border-top-width: 0; border-bottom-width: 0;
    border-radius: 6px;
}
.debug-toggle:hover, .debug-toggle:active {
    color: rgb(255, 255, 255);
    background-color: rgba(10, 10, 14, 0.7);
}

