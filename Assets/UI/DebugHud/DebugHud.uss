.debug-hud-root {
    flex-grow: 1;
}

.debug-panel {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 380px;
    padding: 8px 12px;
    /* 하늘 배경이 밝아서 반투명하면 글자가 묻힌다 — 진하게 깐다. */
    background-color: rgba(10, 10, 14, 0.78);
    border-radius: 6px;
}

.debug-text {
    color: rgb(180, 230, 180);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

/* 시뮬 정지 — 놓치면 안 되는 한 줄이라 다른 값들과 다르게 보인다 */
.debug-text--faulted {
    color: rgb(255, 92, 92);
    -unity-font-style: bold;
}

/* 감췄을 때만 보이는 되살리기 안내. 패널과 같은 모서리에 두되 눈에 안 걸리게 작고 흐리게. */
.debug-hint {
    position: absolute;
    top: 8px; left: 8px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.28);
}

