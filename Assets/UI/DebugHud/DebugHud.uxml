<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="DebugHud.uss" />
    <ui:VisualElement name="debug-hud-root" class="debug-hud-root" picking-mode="Ignore">
        <ui:VisualElement name="debug-panel" class="debug-panel" picking-mode="Ignore">
            <ui:Label name="tick-text" class="debug-text" text="Client tick: 0" />
            <ui:Label name="server-tick-text" class="debug-text" text="Server tick: 0" />
            <ui:Label name="lead-text" class="debug-text" text="Lead: 0 tick" />
            <ui:Label name="elapsed-text" class="debug-text" text="Elapsed: 0.00 s" />
            <ui:Label name="rtt-text" class="debug-text" text="RTT: 0 ms" />
            <ui:Label name="recon-last-text" class="debug-text" text="Recon last: 0.00 m" />
            <ui:Label name="recon-avg-text" class="debug-text" text="Recon avg: 0.00 m" />
            <ui:Label name="recon-max-text" class="debug-text" text="Recon max: 0.00 m" />
            <ui:Label name="timing-avgd-text" class="debug-text" text="d avg: 0.0" />
            <ui:Label name="timing-maxd-text" class="debug-text" text="d max: 0" />
            <ui:Label name="timing-prune-text" class="debug-text" text="Prune: 0" />
            <ui:Label name="timing-seqgap-text" class="debug-text" text="SeqGap: 0" />
            <ui:Label name="snapshot-count-text" class="debug-text" text="Snap count: 0" />
            <ui:Label name="snapshot-tick-text" class="debug-text" text="Snap tick: -1" />
            <ui:Label name="fps-text" class="debug-text" text="FPS: 0 (0.0 ms)" />
            <ui:Label name="entity-count-text" class="debug-text" text="Entities: 0" />
            <ui:Label name="snap-lag-text" class="debug-text" text="Snap lag: 0 tick" />
            <ui:Label name="snap-interval-text" class="debug-text" text="Snap gap: 0.0 / 0.0 ms" />
            <ui:Label name="cushion-text" class="debug-text" text="Cushion: 0.0 ms" />
            <ui:Button name="reset-button" class="debug-text" text="Reset stats" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
