.dodge-pad-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.joystick-area { position: absolute; left: 0; right: 0; bottom: 0; height: 50%; }

.joystick-bg {
    position: absolute; width: 160px; height: 160px;
    border-radius: 80px; background-color: rgba(255, 255, 255, 0.12);
}
.joystick-handle {
    position: absolute; width: 64px; height: 64px;
    border-radius: 32px; background-color: rgba(255, 255, 255, 0.45);
}

.lives-box {
    position: absolute; left: 16px; top: 16px;
    flex-direction: row; align-items: center;
    padding: 6px 10px; border-radius: 5px;
    background-color: rgba(10, 10, 14, 0.7);
}
.hearts { flex-direction: row; }
.heart { width: 30px; height: 28px; margin-right: 4px; }
.lives-label { color: rgb(255, 224, 130); font-size: 28px; -unity-font-style: bold; }

.stage-box {
    position: absolute; top: 16px; left: 30%; right: 30%;
    align-items: center;
}
.stage-label {
    padding: 2px 10px; border-radius: 5px;
    background-color: rgba(10, 10, 14, 0.7);
    color: rgb(255, 255, 255); font-size: 22px; -unity-font-style: bold;
}
.stage-bar {
    margin-top: 6px; width: 100%; height: 8px; border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.2);
}
.stage-bar-fill {
    height: 100%; width: 0%; border-radius: 4px;
    background-color: rgb(255, 224, 130);
}
.stage-bar-fill--sudden { background-color: rgb(255, 80, 70); }

.caption-label {
    margin-top: 8px; padding: 4px 14px; border-radius: 4px;
    background-color: rgba(10, 10, 14, 0.75);
    border-left-width: 4px; border-left-color: rgb(255, 79, 94);
    color: rgb(255, 255, 255); font-size: 22px;
    white-space: nowrap; flex-shrink: 0;
}

.hit-flash {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    display: none;
    border-width: 18px; border-color: rgba(255, 40, 40, 0.75);
}
.lives-box--hit { background-color: rgba(200, 30, 30, 0.75); }
