.flap-root {
    flex-grow: 1;
}

/* 화면 전체가 입력면 — 위 밴드(팝업 등)가 먼저 입력을 가져간다 */
.flap-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.flap-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    -unity-text-align: middle-center;
    font-size: 28px;
    color: rgba(255, 255, 255, 0.55);
}

/* 대시 버튼 — 버튼 자신이 게이지다. 차오르는 것과 누를 수 있는지를 한 곳에서 보여준다. */
.dash-button {
    position: absolute;
    right: 48px;
    bottom: 120px;
    width: 160px;
    height: 160px;
    border-radius: 80px;
    overflow: hidden;                       /* 채움이 둥근 테두리를 넘지 않게 */
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.25);
    justify-content: center;
    align-items: center;
}

/* 아래에서 위로 차오른다. 높이는 게이지 값에 따라 코드가 정한다. */
.dash-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(255, 214, 92, 0.45);
}

.dash-label {
    /* 아래 숫자와 겹치지 않게 가운데에서 위로 22px 올린다(가운데 정렬된 자식의 아래 여백). */
    margin-bottom: 44px;
    font-size: 28px;
    color: rgba(255, 255, 255, 0.45);
    -unity-text-align: middle-center;
}

/* 쌓아 둔 칸 수 — 롤 강타처럼 숫자로 보여 준다. 0칸이면 코드가 빈 문자열을 넣어 사라진다.
   모서리가 아니라 원 안쪽 아래에 둔다: 버튼이 원형 클리핑(overflow:hidden + border-radius)이라
   모서리에 두면 잘려 나간다. 색도 게이지와 같은 호박색이면 다 찼을 때 숫자가 통째로 묻힌다 —
   흰색 + 어두운 그림자라야 빈 버튼(어두움)과 찬 버튼(호박색) 양쪽에서 읽힌다. */
.dash-stacks {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    font-size: 40px;
    color: rgb(255, 255, 255);
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.95);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 가득 찼을 때만 밝아진다 — "지금 쓸 수 있다"가 눈에 띄어야 한다. */
.dash-button--ready {
    border-color: rgb(255, 214, 92);
    background-color: rgba(255, 214, 92, 0.25);
}

.dash-button--ready .dash-fill {
    background-color: rgba(255, 214, 92, 0.75);
}

.dash-button--ready .dash-label {
    color: rgb(255, 255, 255);
}

/* 추격자까지 남은 거리 — 곡선을 튜닝하려면 이 숫자를 봐야 한다 */
.chaser-gap {
    position: absolute;
    left: 32px;
    top: 32px;
    font-size: 30px;
    color: rgba(255, 255, 255, 0.7);
}
