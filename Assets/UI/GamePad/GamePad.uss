.gamepad-root {
    flex-grow: 1;
}

.camera-drag {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.joystick-area {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 45%;
    height: 55%;
}

.joystick-bg {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: var(--lop-radius-pill);
    background-color: rgba(255, 255, 255, 0.18);
    border-width: var(--lop-border-m);
    border-color: var(--lop-outline);
}

.joystick-handle {
    position: absolute;
    left: 55px;
    top: 55px;
    width: 90px;
    height: 90px;
    border-radius: var(--lop-radius-pill);
    background-color: rgba(255, 255, 255, 0.6);
    border-width: var(--lop-border-xs);
    border-color: var(--lop-outline);
}

.action-buttons {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: row;
}

/* 원형 버튼이라 공통 .btn의 좌우 여백을 지우고 라운드를 원으로 고정한다 */
.action-button {
    width: 120px;
    height: 120px;
    border-radius: var(--lop-radius-pill);
    margin-left: 18px;
    font-size: 26px;
    padding-left: 0;
    padding-right: 0;
    border-width: var(--lop-border-m);
}
