.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.top-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 24px;
    align-items: center;
}

.info-text {
    font-size: 26px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.45);
    padding: 4px 12px;
    margin-bottom: 4px;
    border-radius: 6px;
}

.damage-text {
    position: absolute;
    left: 24px;
    top: 24px;
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

/* 중계 자막: 남은 사람·원 안내 띠 아래 */
.ko-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 120px;
    align-items: center;
}

.ko-text {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.55);
    padding: 6px 16px;
    border-radius: 6px;
    white-space: normal;
}

.finish-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}
