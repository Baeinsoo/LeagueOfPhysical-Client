.lobbyhome-root {
    flex-grow: 1;
    justify-content: space-between;
    align-items: center;
    padding: 40px;
    background-image: url("../Lobby/lobby_screen.png");
    -unity-background-scale-mode: scale-and-crop;
}

.lobbyhome-center {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

/* 시작 버튼 — 선택 칩을 품고 있어 예전보다 크고, 안에서 좌우로 나뉜다 */
.lobbyhome-play {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 900px;
    height: 260px;
    padding-left: 40px;
    padding-right: 40px;
}

.lobbyhome-play__text {
    font-size: 96px;
    color: var(--lop-text-on-fill);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--lop-primary-shade);
    -unity-text-align: middle-center;
    margin-right: 40px;
}

.lobbyhome-picks {
    justify-content: center;
}

/* 버튼 면 위에 얹힌 흰 필. 배경이 주황이라 반투명 흰색으로 띄운다 */
.lobbyhome-pick {
    min-width: 400px;
    height: 84px;
    margin-top: 8px;
    margin-bottom: 8px;
    padding-left: 32px;
    padding-right: 32px;
    font-size: 34px;
    color: var(--lop-text);
    background-color: rgba(255, 255, 255, 0.88);
    border-color: rgba(255, 255, 255, 0.95);
    border-width: var(--lop-border-xs);
    border-radius: var(--lop-radius-pill);
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 70ms;
}

/* 유니티 기본 버튼 스타일이 특이도로 이기는 것을 막는다 */
.lobbyhome-pick:hover {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
}

/* 칩은 눌러도 버튼처럼 내려가지 않는다 — 내려가면 시작 버튼이 눌린 것처럼 보인다 */
.lobbyhome-pick:active {
    background-color: var(--lop-surface-sunken);
    scale: 0.97;
}

.lobbyhome-navbar {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 32px;
}

.lobbyhome-nav {
    width: 240px;
    height: 110px;
    font-size: 36px;
    margin-left: 20px;
    margin-right: 20px;
}
