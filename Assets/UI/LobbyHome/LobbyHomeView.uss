/* 로비 홈 — 1부 시안 lobby.html. 1920×1080, 좌우 80 · 위 32 */
.lobbyhome-root { flex-grow: 1; background-color: #262458; }

/* 무대 — 그라데이션 대신 판 몇 장. 3부 터널이 오면 통째로 바뀐다 */
.lobbyhome-stage { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.lobbyhome-stage__wall { position: absolute; top: 0; bottom: 0; width: 30%; background-color: #2D2B66; }
.lobbyhome-stage__wall--left { left: 0; }
.lobbyhome-stage__wall--right { right: 0; }
.lobbyhome-stage__light { position: absolute; left: 27%; width: 46%; top: 14%; height: 74%; border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; background-color: rgba(74, 159, 224, 0.55); justify-content: center; align-items: center; }
.lobbyhome-stage__glow { width: 60%; height: 60%; border-radius: 50%; background-color: rgba(255, 210, 63, 0.8); justify-content: center; align-items: center; }
.lobbyhome-stage__core { width: 50%; height: 50%; border-radius: 50%; background-color: rgba(255, 248, 232, 0.85); }
.lobbyhome-stage__floor { position: absolute; left: 0; right: 0; bottom: 0; height: 26%; background-color: #3D3A86; }

.lobbyhome-safe { position: absolute; left: 80px; right: 80px; top: 32px; bottom: 0; }

.lobbyhome-plate { position: absolute; left: 0; top: 0; }
.lobbyhome-plate .tier-shape { width: 44px; height: 44px; }
/* 이름표 티어 도형은 랭크를 받아 티어를 알 때만(.has-tier). 랭크 모드에선 티어 카드가 대신한다 */
#player-tier { display: none; }
.has-tier #player-tier { display: flex; }
.lobbyhome-rankcard { display: none; flex-direction: row; align-items: center; }
.lobbyhome-plate .lobbyhome-rankcard__emblem { width: 110px; height: 110px; margin-right: 20px; }
.lobbyhome-rankcard__head { font-size: 40px; color: var(--lop-ink); }
.lobbyhome-rankcard__sub { font-size: 22px; color: var(--lop-ink); opacity: 0.8; margin-top: 4px; }
.lobbyhome-coin { position: absolute; right: 0; top: 0; }

.lobbyhome-col { position: absolute; top: 118px; }
.lobbyhome-col--left { left: 0; }
.lobbyhome-col--right { right: 0; }

.lobbyhome-play-group { position: absolute; right: 0; bottom: 92px; align-items: flex-end; }
.lobbyhome-play-group > * { margin-top: 16px; }
.lobbyhome-ranked-note { display: none; position: absolute; left: 0; bottom: 100px; font-size: 30px; color: var(--lop-face); opacity: 0.8; }

.lobbyhome-ticker { position: absolute; left: 0; right: 0; bottom: 0; }

/* 랭크 — 배치는 같고 톤만 가라앉는다(1부 §3.8) */
.ranked.lobbyhome-root { background-color: #1F1D4A; }
.ranked .lobbyhome-stage__wall { background-color: #221F50; }
.ranked .lobbyhome-stage__light { background-color: rgba(31, 29, 74, 0.6); }
.ranked .lobbyhome-stage__glow { background-color: rgba(232, 50, 47, 0.7); }
.ranked .lobbyhome-stage__floor { background-color: #2D2B66; }
.ranked .lobbyhome-col--left { top: 168px; }
.ranked .lobbyhome-rankcard { display: flex; }
.ranked .lobbyhome-plate .kit-plate__name, .ranked .lobbyhome-plate .kit-plate__meta, .ranked.has-tier #player-tier, .ranked #player-tier { display: none; }
.ranked .lobbyhome-gamechip { display: none; }
.ranked .lobbyhome-ranked-note { display: flex; }
.ranked .kit-ticker__tag-text { letter-spacing: 3px; }

/* 낮은 화면(20:9 등, 패널 높이 < 1070) — 버튼을 줄이고 전환 칩·종목 칩을 PLAY 왼쪽으로. LobbyLayout이 .short를 붙인다
 * 오른쪽 줄 아래 = 150 + 3×120 + 2×12 = 534, PLAY 위 = 높이 − 92 − 192 (21:9 높이 823에서도 539) */
.short .kit-nav { height: 120px; margin-bottom: 12px; }
.short .lobbyhome-play-group > * { margin-top: 0; }
.short .lobbyhome-play-group .kit-toggle { position: absolute; right: 476px; bottom: 88px; }
.short .lobbyhome-play-group .lobbyhome-gamechip { position: absolute; right: 476px; bottom: 0; }
