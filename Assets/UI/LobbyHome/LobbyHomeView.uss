/* 로비 홈 — 1부 시안 lobby.html. 1920×1080 기준, 좌우 80 · 위 32.
 * 패널은 Expand라 높이가 1080보다 작아지지 않는다 — 넓은 폰은 가로만, 태블릿은 세로만 늘고 버튼은 모서리에 붙어 있다 */
.lobbyhome-root { flex-grow: 1; background-color: rgba(0, 0, 0, 0); }

/* 가운데는 3D 선수 입장 터널(LobbyStage)이 그린다 — 여긴 배경을 두지 않는다 */

.lobbyhome-safe { position: absolute; left: 80px; right: 80px; top: 32px; bottom: 0; }

/* 일반 이름표와 랭크 티어 카드는 같은 크기 — 모드를 바꿔도 아래 버튼 줄이 움직이지 않는다 */
.lobbyhome-plate { position: absolute; left: 0; top: 0; height: 96px; min-width: 560px; }
.lobbyhome-plate .tier-shape { width: 44px; height: 44px; }
/* 이름표 티어 도형은 랭크를 받아 티어를 알 때만(.has-tier). 랭크 모드에선 티어 카드가 대신한다 */
#player-tier { display: none; }
.has-tier #player-tier { display: flex; }
.lobbyhome-rankcard { display: none; flex-direction: row; align-items: center; }
.lobbyhome-plate .lobbyhome-rankcard__emblem { width: 60px; height: 60px; margin-right: 16px; }
.lobbyhome-rankcard__head { font-size: 32px; color: var(--lop-ink); }
.lobbyhome-rankcard__sub { font-size: 22px; color: var(--lop-ink); opacity: 0.8; }
.lobbyhome-coin { position: absolute; right: 0; top: 0; }

.lobbyhome-col { position: absolute; top: 118px; }
.lobbyhome-col--left { left: 0; }
.lobbyhome-col--right { right: 0; }

.lobbyhome-play-group { position: absolute; right: 0; bottom: 92px; align-items: flex-end; }
.lobbyhome-play-group > * { margin-top: 16px; }
.lobbyhome-rankedchip { display: none; }

.lobbyhome-ticker { position: absolute; left: 0; right: 0; bottom: 0; }

/* 랭크 — 배치는 같고 톤만 가라앉는다(1부 §3.8) */
.ranked .lobbyhome-rankcard { display: flex; }
.ranked .lobbyhome-plate .kit-plate__name, .ranked .lobbyhome-plate .kit-plate__meta, .ranked.has-tier #player-tier, .ranked #player-tier { display: none; }
.ranked .lobbyhome-gamechip { display: none; }
.ranked .lobbyhome-rankedchip { display: flex; }
.ranked .kit-ticker__tag-text { letter-spacing: 3px; }

/* 방송 선수 소개 자막 — 랭크에서 왼쪽 밖에서 미끄러져 들어온다(0.25초 뒤, 0.55초) */
.lobbyhome-lower { position: absolute; left: 0; bottom: 92px; max-width: 640px; translate: -800px 0; transition-property: translate; transition-duration: 0.55s; transition-delay: 0.25s; transition-timing-function: ease-out-cubic; }
.ranked .lobbyhome-lower { translate: 0 0; }
.lobbyhome-lower__tag { align-self: flex-start; background-color: #E8322F; color: #FFF8E8; font-size: 22px; padding: 4px 18px; letter-spacing: 3px; white-space: nowrap; }
.lobbyhome-lower__name { flex-direction: row; align-items: flex-end; background-color: #FFF8E8; padding: 6px 24px 2px 24px; }
.lobbyhome-lower__player { font-size: 46px; color: #2C2A6B; white-space: nowrap; overflow: hidden; max-width: 260px; flex-shrink: 0; }
.lobbyhome-lower__rank { font-size: 26px; color: #B8860B; margin-left: 16px; margin-bottom: 6px; white-space: nowrap; overflow: hidden; max-width: 300px; flex-shrink: 0; }
.lobbyhome-lower__stats { flex-direction: row; align-items: center; background-color: #2C2A6B; padding: 8px 24px; margin-top: 8px; }
.lobbyhome-lower__form { flex-direction: row; align-items: center; margin-right: 22px; }
.lobbyhome-lower__label { color: #FFF8E8; font-size: 22px; margin-right: 10px; white-space: nowrap; }
.lobbyhome-lower__chips { flex-direction: row; }
.lobbyhome-lower__chip { min-width: 46px; height: 30px; margin-right: 6px; border-radius: 15px; background-color: #4B4878; color: #FFF8E8; font-size: 18px; -unity-text-align: middle-center; }
.lobbyhome-lower__chip--first { background-color: #FFD23F; color: #3A2A00; }
.lobbyhome-lower__sub { color: #FFF8E8; font-size: 22px; white-space: nowrap; }

/* 중계 표시 — 랭크에서만 */
.lobbyhome-broadcast { position: absolute; top: 44px; left: 50%; translate: -50% 0; max-width: 420px; flex-direction: row; align-items: center; background-color: rgba(14, 12, 42, 0.82); border-radius: 6px; padding: 8px 22px; opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.ranked .lobbyhome-broadcast { opacity: 1; }
.lobbyhome-broadcast__live { color: #FF4B47; font-size: 22px; letter-spacing: 3px; margin-right: 14px; white-space: nowrap; }
.lobbyhome-broadcast__text { color: #FFF8E8; font-size: 22px; white-space: nowrap; }
.lobbyhome-corner { position: absolute; width: 64px; height: 64px; border-color: rgba(255, 248, 232, 0.7); opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.ranked .lobbyhome-corner { opacity: 1; }
.lobbyhome-corner--tl { left: 22px; top: 18px; border-top-width: 4px; border-left-width: 4px; }
.lobbyhome-corner--tr { right: 22px; top: 18px; border-top-width: 4px; border-right-width: 4px; }
.lobbyhome-corner--bl { left: 22px; bottom: 78px; border-bottom-width: 4px; border-left-width: 4px; }
.lobbyhome-corner--br { right: 22px; bottom: 78px; border-bottom-width: 4px; border-right-width: 4px; }
