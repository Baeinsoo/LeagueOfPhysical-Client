/* 로비 홈 — 1부 시안 lobby.html. 1920×1080 기준, 좌우 80 · 위 32.
 * 패널은 Expand라 높이가 1080보다 작아지지 않는다 — 넓은 폰은 가로만, 태블릿은 세로만 늘고 버튼은 모서리에 붙어 있다 */
.lobbyhome-root { flex-grow: 1; background-color: #262458; }

/* 무대는 키트 .kit-stage(3부 타이틀과 같이 쓴다). 3부 터널이 오면 통째로 바뀐다 */

.lobbyhome-safe { position: absolute; left: 80px; right: 80px; top: 32px; bottom: 0; }

/* 일반 이름표와 랭크 티어 카드는 같은 크기 — 모드를 바꿔도 아래 버튼 줄이 움직이지 않는다 */
.lobbyhome-plate { position: absolute; left: 0; top: 0; height: 96px; min-width: 560px; }
.lobbyhome-plate .tier-shape { width: 44px; height: 44px; }
/* 이름표 티어 도형은 랭크를 받아 티어를 알 때만(.has-tier). 랭크 모드에선 티어 카드가 대신한다 */
#player-tier { display: none; }
.has-tier #player-tier { display: flex; }
.lobbyhome-rankcard { display: none; flex-direction: row; align-items: center; }
.lobbyhome-plate .lobbyhome-rankcard__emblem { width: 60px; height: 60px; margin-right: 16px; }
.lobbyhome-rankcard__head { font-size: 32px; color: var(--lop-ink); }
.lobbyhome-rankcard__sub { font-size: 22px; color: var(--lop-ink); opacity: 0.8; }
.lobbyhome-coin { position: absolute; right: 0; top: 0; }

.lobbyhome-col { position: absolute; top: 118px; }
.lobbyhome-col--left { left: 0; }
.lobbyhome-col--right { right: 0; }

.lobbyhome-play-group { position: absolute; right: 0; bottom: 92px; align-items: flex-end; }
.lobbyhome-play-group > * { margin-top: 16px; }
.lobbyhome-rankedchip { display: none; }

.lobbyhome-ticker { position: absolute; left: 0; right: 0; bottom: 0; }

/* 랭크 — 배치는 같고 톤만 가라앉는다(1부 §3.8) */
.ranked.lobbyhome-root { background-color: #1F1D4A; }
.ranked .lobbyhome-rankcard { display: flex; }
.ranked .lobbyhome-plate .kit-plate__name, .ranked .lobbyhome-plate .kit-plate__meta, .ranked.has-tier #player-tier, .ranked #player-tier { display: none; }
.ranked .lobbyhome-gamechip { display: none; }
.ranked .lobbyhome-rankedchip { display: flex; }
.ranked .kit-ticker__tag-text { letter-spacing: 3px; }
