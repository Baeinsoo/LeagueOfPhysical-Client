<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lop="LOP.UI">
    <!-- 로비 홈 (1부 시안 lobby.html). 랭크면 루트에 .ranked가 붙어 톤만 바뀐다. -->
    <ui:VisualElement name="lobbyhome-root" class="kit lobbyhome-root">
        <ui:VisualElement class="lobbyhome-safe" picking-mode="Ignore">
            <!-- 왼쪽 위: 이름표(일반) / 티어 카드(랭크) -->
            <ui:Button name="player-plate" class="kit-press kit-plate lobbyhome-plate">
                <lop:StickerElement>
                    <ui:Label name="player-name" class="kit-plate__name" />
                    <ui:Label name="player-meta" class="kit-plate__meta" />
                    <lop:TierShapeElement name="player-tier" />
                    <ui:VisualElement name="rank-card" class="lobbyhome-rankcard">
                        <lop:TierShapeElement name="rank-tier" class="lobbyhome-rankcard__emblem" />
                        <ui:VisualElement class="lobbyhome-rankcard__text">
                            <ui:Label name="rank-head" class="kit-title lobbyhome-rankcard__head" />
                            <ui:Label name="rank-sub" class="lobbyhome-rankcard__sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </lop:StickerElement>
            </ui:Button>
            <!-- 오른쪽 위: 코인 -->
            <ui:VisualElement class="kit-coin lobbyhome-coin">
                <lop:StickerElement><ui:Label name="coin-value" text="🪙 -" class="kit-coin__text" /></lop:StickerElement>
            </ui:VisualElement>
            <!-- 왼쪽 줄 -->
            <ui:VisualElement class="lobbyhome-col lobbyhome-col--left">
                <ui:Button name="nav-shop" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="🛍️" class="kit-nav__icon" /><ui:Label text="상점" class="kit-nav__label" /></lop:StickerElement><ui:Label class="kit-title kit-badge" /></ui:Button>
                <ui:Button name="nav-locker" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="👕" class="kit-nav__icon" /><ui:Label text="라커룸" class="kit-nav__label" /></lop:StickerElement></ui:Button>
                <ui:Button name="nav-records" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="📊" class="kit-nav__icon" /><ui:Label text="기록" class="kit-nav__label" /></lop:StickerElement></ui:Button>
            </ui:VisualElement>
            <!-- 오른쪽 줄 -->
            <ui:VisualElement class="lobbyhome-col lobbyhome-col--right">
                <ui:Button name="nav-missions" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="🎯" class="kit-nav__icon" /><ui:Label text="미션" class="kit-nav__label" /></lop:StickerElement><ui:Label class="kit-title kit-badge" /></ui:Button>
                <ui:Button name="nav-season" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="🏆" class="kit-nav__icon" /><ui:Label text="시즌" class="kit-nav__label" /></lop:StickerElement></ui:Button>
                <ui:Button name="nav-settings" class="kit-press kit-nav"><lop:StickerElement><ui:Label text="⚙️" class="kit-nav__icon" /><ui:Label text="설정" class="kit-nav__label" /></lop:StickerElement></ui:Button>
            </ui:VisualElement>
            <!-- 왼쪽 아래: 방송 선수 소개 자막(랭크에서만 들어온다) -->
            <ui:VisualElement name="lower-third" class="lobbyhome-lower" picking-mode="Ignore">
                <ui:Label text="RANKED · 출전 대기" class="kit-title lobbyhome-lower__tag" />
                <ui:VisualElement class="lobbyhome-lower__name">
                    <ui:Label name="lower-player" class="kit-title lobbyhome-lower__player" />
                    <ui:Label name="lower-rank" class="kit-title lobbyhome-lower__rank" />
                </ui:VisualElement>
                <ui:VisualElement class="lobbyhome-lower__stats">
                    <ui:VisualElement name="lower-form" class="lobbyhome-lower__form">
                        <ui:Label text="최근 5경기" class="lobbyhome-lower__label" />
                        <ui:VisualElement name="lower-chips" class="lobbyhome-lower__chips" />
                    </ui:VisualElement>
                    <ui:Label name="lower-sub" class="lobbyhome-lower__sub" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- 오른쪽 아래: 전환 칩 → PLAY → 종목 칩(랭크면 안내 칩) -->
            <ui:VisualElement class="lobbyhome-play-group" picking-mode="Ignore">
                <ui:VisualElement class="kit-toggle">
                    <ui:Button name="queue-casual" text="일반" class="kit-toggle__opt" />
                    <ui:Button name="queue-ranked" text="랭크" class="kit-toggle__opt" />
                </ui:VisualElement>
                <ui:Button name="play-button" class="kit-press kit-play">
                    <lop:StickerElement><ui:Label name="play-label" text="PLAY" class="kit-title kit-play__label" /></lop:StickerElement>
                </ui:Button>
                <ui:Button name="game-chip" class="kit-press kit-gamechip lobbyhome-gamechip">
                    <lop:StickerElement><ui:Label name="game-chip-text" class="kit-gamechip__text" /></lop:StickerElement>
                </ui:Button>
                <!-- 랭크면 같은 자리에 안내 칩 — PLAY 위치가 일반과 같게 남는다 -->
                <ui:VisualElement name="ranked-chip" class="kit-gamechip lobbyhome-rankedchip">
                    <lop:StickerElement><ui:Label text="🎲 종목 랜덤 · 실력 맞춤" class="kit-gamechip__text" /></lop:StickerElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 중계 표시(랭크에서만): 위 가운데 LIVE 띠 + 화면 모서리 프레임 -->
        <ui:VisualElement name="broadcast" class="lobbyhome-broadcast" picking-mode="Ignore">
            <ui:Label name="broadcast-live" text="● LIVE" class="kit-title lobbyhome-broadcast__live" />
            <ui:Label text="LOP 아레나 · 리그 경기" class="lobbyhome-broadcast__text" />
        </ui:VisualElement>
        <ui:VisualElement class="lobbyhome-corner lobbyhome-corner--tl" picking-mode="Ignore" />
        <ui:VisualElement class="lobbyhome-corner lobbyhome-corner--tr" picking-mode="Ignore" />
        <ui:VisualElement class="lobbyhome-corner lobbyhome-corner--bl" picking-mode="Ignore" />
        <ui:VisualElement class="lobbyhome-corner lobbyhome-corner--br" picking-mode="Ignore" />

        <!-- 맨 아래: 띠 -->
        <ui:VisualElement class="kit-ticker lobbyhome-ticker">
            <lop:StickerElement class="kit-ticker__tag"><ui:VisualElement class="kit-ticker__dot" /><ui:Label name="ticker-tag" text="LIVE" class="kit-title kit-ticker__tag-text" /></lop:StickerElement>
            <ui:Label name="ticker-text" class="kit-ticker__text" />
            <lop:StickerElement class="kit-ticker__season"><ui:Label text="시즌 1" class="kit-ticker__season-text" /></lop:StickerElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
