<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="lobbyhome-root" class="lobbyhome-root">
        <!-- 상단 코인·레벨 칩. 값은 EconomyStore 구독으로 채운다(LobbyHomeView). -->
        <ui:VisualElement name="lobbyhome-topbar" class="lobbyhome-topbar">
            <ui:VisualElement name="coin-chip" class="lobbyhome-chip">
                <ui:Label name="coin-icon" text="코인" class="lobbyhome-chip__icon" />
                <ui:Label name="coin-value" text="0" class="lobbyhome-chip__value" />
            </ui:VisualElement>
            <ui:VisualElement name="level-chip" class="lobbyhome-chip">
                <ui:Label name="level-value" text="Lv 1" class="lobbyhome-chip__value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="lobbyhome-center" class="lobbyhome-center">
            <!-- 선택은 시작 버튼 안에 들어 있다. 칩을 누르면 그 클릭은 칩이 먹고(전파 차단),
                 그 밖의 면적은 전부 시작이다. -->
            <ui:Button name="play-button" class="btn btn--primary lobbyhome-play">
                <ui:Label name="play-label" text="PLAY" class="lobbyhome-play__text" />
                <ui:VisualElement name="play-picks" class="lobbyhome-picks">
                    <!-- 일반/랭크. 랭크면 아래 두 드롭다운 대신 내 티어를 보여 준다(게임은 서버가 고른다). -->
                    <ui:VisualElement name="queue-picks" class="lobbyhome-queues">
                        <ui:Button name="queue-casual" text="일반" class="lobbyhome-queue" />
                        <ui:Button name="queue-ranked" text="랭크" class="lobbyhome-queue" />
                    </ui:VisualElement>
                    <ui:DropdownField name="game-pick" class="lobbyhome-pick" />
                    <ui:DropdownField name="map-pick" class="lobbyhome-pick" />
                    <ui:Label name="rank-summary" class="lobbyhome-rank" />
                </ui:VisualElement>
            </ui:Button>
        </ui:VisualElement>

        <!-- 하단 네비바: 레이아웃만. 실제 동작은 Slice C에서 배선. -->
        <ui:VisualElement name="nav-bar" class="lobbyhome-navbar">
            <ui:Button name="nav-shop" text="상점" class="btn btn--secondary lobbyhome-nav" />
            <ui:Button name="nav-profile" text="프로필" class="btn btn--nav2 lobbyhome-nav" />
            <ui:Button name="nav-settings" text="설정" class="btn btn--nav3 lobbyhome-nav" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
