/* 로그인 — 타이틀 위 아래 가운데에 버튼 줄. 화면 전체를 덮는 판이 없다(뒤의 타이틀이 그대로 보인다) */
.login-root { flex-grow: 1; }
.login-group { position: absolute; left: 0; right: 0; bottom: 120px; align-items: center; }
.login-row { flex-direction: row; align-items: center; }
.login-root .login-guest { width: 400px; height: 150px; margin-right: 40px; }
.login-root .login-guest__label { font-size: 64px; }
.login-root .login-alt { margin-right: 24px; }
.login-note { margin-top: 22px; font-size: 26px; color: var(--lop-face); text-shadow: 2px 3px 0 var(--lop-ink-deep); -unity-text-align: middle-center; }
/* 실패 문구 — 빨간 면 흰 글자. 안내 글 아래, 줄바꿈 허용 */
.login-error { margin-top: 16px; max-width: 900px; padding: 10px 28px; border-radius: 8px; background-color: var(--lop-live); font-size: 26px; color: #FFFFFF; white-space: normal; -unity-text-align: middle-center; }
