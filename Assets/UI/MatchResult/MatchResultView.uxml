<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:lop="LOP.UI">
    <!-- 결과판 — 왼쪽 키트 큰 판 + 아래 중계 자막 줄 + 오른쪽 아래 확인. 오른쪽 절반은 비워 3D 시상대가 보이게 -->
    <ui:VisualElement name="matchresult-root" class="kit matchresult-root">
        <ui:VisualElement name="matchresult-board" class="kit-panel matchresult-board matchresult-board--out">
            <ui:VisualElement class="kit-panel__back" />
            <ui:VisualElement class="kit-panel__face matchresult-face">
                <ui:VisualElement class="matchresult-head">
                    <ui:Label name="matchresult-tag" text="LIVE" class="matchresult-tag" />
                    <ui:Label name="matchresult-title" text="경기 결과" class="kit-title matchresult-title" />
                    <ui:Label name="matchresult-subtitle" class="matchresult-subtitle" />
                    <ui:Label name="matchresult-draw" text="무승부" class="matchresult-draw" />
                </ui:VisualElement>
                <ui:VisualElement name="matchresult-rows" class="matchresult-rows" />
                <ui:Label name="matchresult-empty" text="경기 종료" class="kit-title matchresult-empty" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="matchresult-lines" class="matchresult-lines">
            <ui:VisualElement name="matchresult-rank" class="matchresult-lt matchresult-lt--rank matchresult-lt--out">
                <ui:Label name="matchresult-rank-tag" class="matchresult-lt__tag" />
                <ui:Label name="matchresult-rank-body" class="matchresult-lt__body" />
            </ui:VisualElement>
            <ui:VisualElement name="matchresult-reward" class="matchresult-lt matchresult-lt--out">
                <ui:Label text="보상" class="matchresult-lt__tag matchresult-lt__tag--reward" />
                <ui:Label name="matchresult-reward-body" class="matchresult-lt__body" />
            </ui:VisualElement>
            <!-- 내 기록(spec §7, 종목 공용) — 지표마다 한 줄. 기록이 없는 판이면 화면이 숨긴다 -->
            <ui:VisualElement name="matchresult-record" class="matchresult-lt matchresult-lt--record matchresult-lt--out">
                <ui:Label text="내 기록" class="matchresult-lt__tag" />
                <ui:VisualElement name="matchresult-record-rows" class="matchresult-lt__body matchresult-record__rows">
                    <ui:Label name="matchresult-newbest" text="NEW BEST!" class="kit-title matchresult-newbest matchresult-newbest--out" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="confirm-button" class="kit-press kit-btn kit-btn--primary matchresult-confirm matchresult-confirm--out">
            <lop:StickerElement><ui:Label text="확인" class="kit-btn__label" /></lop:StickerElement>
        </ui:Button>
        <ui:VisualElement name="matchresult-flash" class="matchresult-flash matchresult-flash--on" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
