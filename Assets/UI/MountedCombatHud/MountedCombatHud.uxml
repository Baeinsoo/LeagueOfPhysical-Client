<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="combat-root" class="combat-root" picking-mode="Ignore">
        <ui:VisualElement name="damage-arc" class="damage-arc" picking-mode="Ignore">
            <ui:VisualElement class="damage-arc-bar" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="zone-warning" class="zone-warning" picking-mode="Ignore" />
        <ui:Label name="hit-marker" class="hit-marker" text="✕" picking-mode="Ignore" />
        <ui:VisualElement name="zone-panel" class="zone-panel" picking-mode="Ignore">
            <ui:Label name="zone-text" class="zone-text" picking-mode="Ignore" />
            <ui:Label name="alive-text" class="alive-text" picking-mode="Ignore" />
            <ui:VisualElement name="minimap-host" class="minimap-host" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="hp-bar" class="hp-bar" picking-mode="Ignore">
            <ui:VisualElement name="hp-fill" class="hp-fill" picking-mode="Ignore" />
            <ui:Label name="hp-text" class="hp-text" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="kill-feed" class="kill-feed" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
