.matching-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.matching-card {
    width: 680px;
}

.matching-title {
    font-size: 48px;
    margin-bottom: 16px;
}

.matching-message {
    font-size: 30px;
    margin-bottom: 36px;
}

.matching-cancel {
    height: 100px;
    font-size: 34px;
}
