.panchigi-turn {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

.turn-label {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.scoreboard { margin-top: 8px; background-color: rgba(0, 0, 0, 0.45); border-radius: 8px; padding: 6px 10px; }
.score-row { flex-direction: row; align-items: center; height: 34px; }
.score-row--current { background-color: rgba(255, 255, 255, 0.12); border-radius: 6px; }
.score-chip { width: 12px; height: 12px; border-radius: 6px; margin-right: 6px; }
.score-name { width: 40px; font-size: 16px; color: rgb(255, 255, 255); }
.score-frame { width: 52px; margin-left: 2px; border-left-width: 1px; border-color: rgba(255, 255, 255, 0.2); align-items: center; }
.score-marks { font-size: 14px; color: rgb(255, 230, 160); }
.score-cum { font-size: 14px; color: rgb(255, 255, 255); }
.score-total { width: 44px; margin-left: 6px; font-size: 18px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: middle-right; }

.charge-track {
    position: absolute;
    left: 24px;
    top: 30%;
    height: 40%;
    width: 18px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    justify-content: flex-end;
}

.charge-fill {
    width: 100%;
    height: 0;
    border-radius: 9px;
}
