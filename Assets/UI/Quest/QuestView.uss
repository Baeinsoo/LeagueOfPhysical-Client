/* 퀘스트 판 — 1920×1080 기준(Expand, ADR 0019). 묶음 둘을 세로로, 카드는 가로로 늘어놓는다(넘치면 스크롤). */
.quest-body { flex-direction: column; }
.quest-message { font-size: 32px; color: var(--lop-face); align-self: center; margin: 8px 0; display: none; }
.quest-scroll { flex-grow: 1; }
.quest-section { margin-bottom: 28px; }
.quest-section__head { flex-direction: row; align-items: center; margin-bottom: 12px; }
.quest-section__title { font-size: 44px; color: var(--lop-face); }
.quest-section__remaining { font-size: 28px; color: var(--lop-face); opacity: 0.8; margin-left: 20px; }
.quest-section__reroll { font-size: 28px; color: var(--lop-reward); margin-left: auto; }
.quest-list { flex-direction: row; flex-wrap: wrap; }
/* M1: 420px는 진행+보상+바꾸기가 한 줄에 다 못 들어갔다(≈430~460px 필요) — 560px로 넓힌다
   (오늘 3장 = 1728px, 셸 몸통 1856px 안에 든다. 이번 주 4장은 두 줄로 접힌다). */
.quest-card { width: 560px; margin: 0 16px 16px 0; }
/* I1: kit-panel은 모양이 없다 — back·face 자식이 바탕을 그린다. face 기본(48px·center)을 카드에 맞게 덮는다. */
.quest-card .kit-panel__face { padding: 18px 20px; align-items: stretch; }
.quest-card__head { flex-direction: row; align-items: center; }
.quest-card__tier { font-size: 24px; color: var(--lop-ink); background-color: var(--lop-reward); border-radius: 12px; padding: 2px 10px; margin-right: 10px; }
.quest-card__title { font-size: 30px; flex-shrink: 1; }
.quest-card__bar { margin-top: 14px; }
.quest-card__foot { flex-direction: row; align-items: center; margin-top: 12px; min-height: 56px; }
.quest-card__progress { font-size: 28px; color: var(--lop-ink); }
.quest-card__reward { font-size: 26px; color: var(--lop-ink); margin-left: 14px; opacity: 0.85; }
.quest-card__reroll { margin-left: auto; }
/* I1: 크림 바탕에 노랑 글자는 대비가 거의 없다 — 잉크 글자 + 노랑 배지로(난이도 칩과 같은 꼴). */
.quest-card__stamp { margin-left: auto; font-size: 28px; color: var(--lop-ink); background-color: var(--lop-reward); border-radius: 12px; padding: 4px 14px; rotate: -6deg; }
.quest-card--done { opacity: 0.6; }
