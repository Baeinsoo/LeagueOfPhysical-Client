/* Flappy 정보 HUD. 수치는 시제품(960×540)의 2배 — 패널 기준이 1920×1080, 가로 맞춤이다. */
.race-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 기록 시간 — 왼쪽 위 작게. 디버그 손잡이(왼쪽 위 8px, 88×44)를 피해 그 오른쪽에 둔다. */
.race-clock-plate {
    position: absolute;
    left: 108px;
    top: 16px;
    width: 192px;
    height: 64px;
    padding-left: 24px;
    border-radius: 20px;
    background-color: rgba(17, 14, 12, 0.72);
    justify-content: center;
}

.race-clock {
    font-size: 36px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-left;
}

/* 진행 막대 — 위 가운데. 트랙 1120px(시제품 560) + 양옆 28px 여백의 어두운 판. */
.race-progress {
    position: absolute;
    top: 24px;
    left: 372px;
    width: 1176px;
    height: 76px;
    padding-left: 28px;
    padding-right: 28px;
    border-radius: 24px;
    background-color: rgba(17, 14, 12, 0.72);
    justify-content: center;
}

.race-progress-track {
    height: 14px;
    border-radius: 6px;
    background-color: rgb(58, 49, 42);
}

/* 내 진행 — 호박색. 폭은 코드가 정한다(0이어도 끝이 보이게 최소 8px). */
.race-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    min-width: 8px;
    border-radius: 6px;
    background-color: rgb(255, 179, 71);
}

/* 결승 — 트랙 끝 흰 세로줄. */
.race-progress-goal {
    position: absolute;
    right: -3px;
    top: -12px;
    width: 6px;
    height: 38px;
    background-color: rgb(243, 235, 226);
}

.race-progress-dots {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 남의 점 — 지름 24(시제품 12), 검은 테두리. 색·가로 자리는 코드가 정한다. */
.race-dot {
    position: absolute;
    top: -5px;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(17, 14, 12);
}

/* 내 점 — 지름 36(시제품 18), 흰 테두리, 눈. */
.race-dot--mine {
    top: -11px;
    width: 36px;
    height: 36px;
    margin-left: -18px;
    border-radius: 18px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
}

.race-dot__eye {
    display: none;
    position: absolute;
    left: 15px;
    top: 6px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(27, 18, 8);
}

.race-dot--mine .race-dot__eye {
    display: flex;
}

/* 순위 — 오른쪽 위 크게(184×116, 시제품 92×58). 튕김은 판 전체 크기로 한다. */
.race-rank-plate {
    position: absolute;
    right: 32px;
    top: 20px;
    width: 184px;
    height: 116px;
    border-radius: 24px;
    background-color: rgba(17, 14, 12, 0.72);
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transform-origin: center;
}

.race-rank {
    font-size: 80px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.race-rank-side {
    align-items: flex-start;
}

.race-rank-unit {
    font-size: 32px;
    color: rgb(169, 156, 143);
}

.race-rank-total {
    font-size: 22px;
    color: rgb(169, 156, 143);
}
