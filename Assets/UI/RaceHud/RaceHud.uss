/* Flappy 정보 HUD. 수치는 시제품(960×540)의 2배 — 패널 기준이 1920×1080, 가로 맞춤이다. */
.race-hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 기록 시간 — 왼쪽 위 작게. 디버그 손잡이(왼쪽 위 8px, 88×44)를 피해 그 오른쪽에 둔다. */
.race-clock-plate {
    position: absolute;
    left: 108px;
    top: 16px;
    width: 192px;
    height: 64px;
    padding-left: 24px;
    border-radius: 20px;
    background-color: rgba(17, 14, 12, 0.72);
    justify-content: center;
}

.race-clock {
    font-size: 36px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-left;
}

/* 진행 막대 — 위 가운데. 트랙 1120px(시제품 560) + 양옆 28px 여백의 어두운 판. */
.race-progress {
    position: absolute;
    top: 24px;
    left: 372px;
    width: 1176px;
    height: 76px;
    padding-left: 28px;
    padding-right: 28px;
    border-radius: 24px;
    background-color: rgba(17, 14, 12, 0.72);
    justify-content: center;
}

.race-progress-track {
    height: 14px;
    border-radius: 6px;
    background-color: rgb(58, 49, 42);
}

/* 내 진행 — 호박색. 폭은 코드가 정한다(0이어도 끝이 보이게 최소 8px). */
.race-progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    min-width: 8px;
    border-radius: 6px;
    background-color: rgb(255, 179, 71);
}

/* 결승 — 트랙 끝 흰 세로줄. */
.race-progress-goal {
    position: absolute;
    right: -3px;
    top: -12px;
    width: 6px;
    height: 38px;
    background-color: rgb(243, 235, 226);
}

.race-progress-dots {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 남의 점 — 지름 24(시제품 12), 검은 테두리. 색·가로 자리는 코드가 정한다. */
.race-dot {
    position: absolute;
    top: -5px;
    width: 24px;
    height: 24px;
    margin-left: -12px;
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(17, 14, 12);
}

/* 내 점 — 지름 36(시제품 18), 흰 테두리, 눈. */
.race-dot--mine {
    top: -11px;
    width: 36px;
    height: 36px;
    margin-left: -18px;
    border-radius: 18px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
}

.race-dot__eye {
    display: none;
    position: absolute;
    left: 15px;
    top: 6px;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgb(27, 18, 8);
}

.race-dot--mine .race-dot__eye {
    display: flex;
}

/* 순위 — 오른쪽 위 크게(184×116, 시제품 92×58). 튕김은 판 전체 크기로 한다. */
.race-rank-plate {
    position: absolute;
    right: 32px;
    top: 20px;
    width: 184px;
    height: 116px;
    border-radius: 24px;
    background-color: rgba(17, 14, 12, 0.72);
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transform-origin: center;
}

.race-rank {
    font-size: 80px;
    -unity-text-align: middle-center;
    margin-right: 8px;
}

.race-rank-side {
    align-items: flex-start;
}

.race-rank-unit {
    font-size: 32px;
    color: rgb(169, 156, 143);
}

.race-rank-total {
    font-size: 22px;
    color: rgb(169, 156, 143);
}

/* 구간 띠 층(spec §5) — 트랙 전체. 띠 하나 = 막 색 0.25 + 구간 시작 눈금 4px(시제품 ACT_COL·2px). 자리·폭·색은 코드가 정한다. */
.race-progress-bands {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.race-band {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left-width: 4px;
    border-left-color: rgb(17, 14, 12);
}

/* 추월 ±1 — 순위 판 바로 왼쪽(시제품 W-112 → 오른쪽 224px), 44px. 색·투명도·떠오름은 코드가 정한다. */
.race-rank-delta {
    position: absolute;
    right: 224px;
    top: 36px;
    font-size: 44px;
    -unity-text-align: upper-right;
}

/* 구간 배너 — "n막" 24px · 이름 60px · 막 색 띠 360×8. 투명도는 코드가 정한다.
   top은 20%(216px, 1080 기준)다 — 이름 기준선이 화면 높이 28%(302px)쯤(시제품 H×0.28)이어야 하는데,
   배너 자체는 "n막" 줄 위에서 시작해 그 아래로 이름이 쌓인다: 20%(216) + "n막" 줄(~30, 24px 글자 +
   줄 간격) + 이름 글자가 기준선까지 차는 몫(~60, 60px 글자의 베이스라인 오프셋) ≈ 306px ≈ 28%. */
.race-banner {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 20%;
    align-items: center;
}

.race-banner-act {
    font-size: 24px;
    color: rgb(169, 156, 143);
    -unity-text-align: middle-center;
}

.race-banner-title {
    font-size: 60px;
    color: rgb(243, 235, 226);
    -unity-text-align: middle-center;
}

.race-banner-bar {
    width: 360px;
    height: 8px;
    margin-top: 8px;
}

/* LAST STRETCH! — 10-26 사용자 피드백: 너무 크고 복도 가운데를 가린다. 위 진행 막대 바로 아래(top 24 + 76)로
   내려 복도 시야를 트고, 분홍 판·글자를 가로세로·글자 크기 모두 반(340×56, 34px)으로 줄이고, 기울기도 조금
   줄인다(−2.86° → −2°), 판은 살짝 비치게(배경 알파 0.85) — 타이밍(1.8초)·소리는 그대로. */
.race-stretch {
    display: none;
    position: absolute;
    left: 50%;
    top: 112px;
    width: 340px;
    height: 56px;
    margin-left: -170px;
    border-radius: 20px;
    background-color: rgba(255, 143, 177, 0.85);
    justify-content: center;
    align-items: center;
    rotate: -2deg;
    transform-origin: center;
}

.race-stretch-text {
    font-size: 34px;
    color: rgb(27, 18, 8);
    -unity-text-align: middle-center;
}
