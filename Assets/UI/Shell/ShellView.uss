.shell-root {
    flex-grow: 1;
    background-color: var(--lop-surface);
}

.shell-header {
    flex-direction: row;
    align-items: center;
    height: 130px;
    padding: 20px;
}

.shell-back {
    width: 220px;
    height: 90px;
    font-size: 32px;
}

.shell-title {
    flex-grow: 1;
    font-size: 48px;
}

.shell-body {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.shell-placeholder {
    font-size: 34px;
}

/* 프로필 셸 본문. 다른 셸은 이 클래스를 안 쓰므로 규칙만 있고 대상이 없다. */
.profile-body {
    /* .shell-body의 가운데 정렬을 되돌린다 — 안 그러면 자식이 내용 너비로 쭈그러들어
       아래 space-between이 무의미해지고 라벨과 값이 붙어 버린다. */
    justify-content: flex-start;
    align-items: stretch;
    padding: 20px;
}

.profile-status {
    font-size: 34px;
    margin-bottom: 16px;
}

.profile-queues {
    flex-direction: column;
}

.profile-queue {
    flex-direction: column;
    margin-bottom: 28px;
}

.profile-queue-name {
    font-size: 40px;
    margin-bottom: 8px;
}

.profile-stat {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 4px;
    padding-bottom: 4px;
}

.profile-stat-label {
    font-size: 30px;
}

.profile-stat-value {
    font-size: 30px;
}
