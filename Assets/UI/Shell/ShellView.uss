.shell-root {
    flex-grow: 1;
    background-color: var(--lop-surface);
}

.shell-header {
    flex-direction: row;
    align-items: center;
    height: 130px;
    padding: 20px;
}

.shell-back {
    width: 220px;
    height: 90px;
    font-size: 32px;
}

.shell-title {
    flex-grow: 1;
    font-size: 48px;
}

.shell-body {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.shell-placeholder {
    font-size: 34px;
}
