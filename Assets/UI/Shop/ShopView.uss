/* 키트 상점 — 1920×1080 기준. 탭 줄, 5열 카드 그리드, 아래 고른 품목 막대, 구매 확인 겹창. */
.shop-body { justify-content: flex-start; align-items: stretch; }
.shop-tabs { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 16px; }
.shop-tab { margin-right: 16px; }

.shop-grid { flex-grow: 1; }
.shop-grid > .unity-scroll-view__content-container { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; padding: 8px 0; }
.shop-card { height: 300px; margin: 8px 20px 16px 20px; }
.shop-card__state--dim { opacity: 0.45; }
.shop-card--picked { width: 312px; margin: 2px 14px 10px 14px; border-width: 6px; border-color: var(--lop-primary); border-radius: 16px; }

.shop-message { flex-shrink: 0; font-size: 28px; color: var(--lop-live); -unity-font-style: bold; margin-bottom: 8px; display: none; }

.shop-bar { flex-direction: row; align-items: center; flex-shrink: 0; height: 96px; }
.shop-bar__name { font-size: 40px; color: var(--lop-face); max-width: 640px; overflow: hidden; white-space: nowrap; }
.shop-bar__state { font-size: 30px; color: var(--lop-reward); margin-left: 24px; white-space: nowrap; }
.shop-bar__hint { font-size: 28px; color: var(--lop-face); margin-left: auto; margin-right: 24px; white-space: nowrap; display: none; }
.shop-bar__buy { margin-left: auto; margin-right: 24px; }

.shop-confirm { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--lop-scrim); justify-content: center; align-items: center; display: none; }
.shop-confirm--open { display: flex; }
.shop-confirm__panel { width: 860px; }
.shop-confirm__face { padding: 48px 56px; }
.shop-confirm__question { font-size: 40px; color: var(--lop-ink); white-space: normal; -unity-text-align: middle-center; margin-bottom: 16px; }
.shop-confirm__remaining { font-size: 28px; color: var(--lop-ink); margin-bottom: 24px; }
.shop-confirm__equip { font-size: 28px; color: var(--lop-ink); margin-bottom: 32px; }
.shop-confirm__equip .unity-toggle__label { font-size: 28px; color: var(--lop-ink); min-width: 0; }
.shop-confirm__buttons { flex-direction: row; }
.shop-confirm__no { margin-right: 32px; }
.shop-confirm__no .kit-btn__label { color: var(--lop-ink); }
