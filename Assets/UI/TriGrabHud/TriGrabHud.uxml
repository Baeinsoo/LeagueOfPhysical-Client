<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="TriGrabHud.uss" />
    <ui:VisualElement name="trigrab-hud-root" class="trigrab-hud-root" picking-mode="Ignore">
        <!-- 위 가운데 주문 띠. 주문의 색 이름은 그 색으로 칠한다. -->
        <ui:VisualElement name="rule-box" class="rule-box" picking-mode="Ignore">
            <ui:Label name="round-text" class="round-text" text="" picking-mode="Ignore" />
            <!-- 이번 라운드 남은 시간(8초 상한까지). -->
            <ui:VisualElement name="time-bar" class="time-bar" picking-mode="Ignore">
                <ui:VisualElement name="time-fill" class="time-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="rule-text" class="rule-text" text="" enable-rich-text="true" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- 오른쪽 점수판. 줄은 코드가 사람 수만큼 만든다. -->
        <ui:VisualElement name="scoreboard" class="scoreboard" picking-mode="Ignore" />
        <!-- 준비 중 "라운드 N / 10". 주문은 원판 가운데(월드)에 크게 뜬다. -->
        <ui:VisualElement name="prep-box" class="prep-box" picking-mode="Ignore">
            <ui:Label name="prep-title" class="prep-title" text="" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="toast-box" class="toast-box" picking-mode="Ignore">
            <ui:Label name="toast-text" class="toast-text" text="" picking-mode="Ignore" />
            <ui:Label name="toast-sub" class="toast-sub" text="" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
