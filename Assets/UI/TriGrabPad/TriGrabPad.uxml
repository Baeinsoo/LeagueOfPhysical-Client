<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="TriGrabPad.uss" />
    <ui:VisualElement name="trigrab-pad-root" class="trigrab-pad-root" picking-mode="Ignore">
        <!-- 왼쪽 반 아래 어디를 눌러도 그 자리가 이동 스틱 중심이 된다. -->
        <ui:VisualElement name="joystick-area" class="joystick-area">
            <ui:VisualElement name="joystick-bg" class="joystick-bg" picking-mode="Ignore">
                <ui:VisualElement name="joystick-handle" class="joystick-handle" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 오른쪽 반 아래 = 조준 스틱. 바깥으로 끌어 떼기 = 그 방향으로 손, 톡·안쪽으로 되돌아와 떼기 = 취소. -->
        <ui:VisualElement name="fire-area" class="fire-area" />
        <ui:VisualElement name="fire-button" class="fire-button" picking-mode="Ignore">
            <ui:Label name="fire-label" class="fire-label" text="손" picking-mode="Ignore" />
            <ui:VisualElement name="fire-handle" class="fire-handle" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Button name="leave-button" class="leave-button" text="나가기" />
    </ui:VisualElement>
</ui:UXML>
