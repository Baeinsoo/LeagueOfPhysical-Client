{
  "name": "knockback-barrels-off",
  "description": "넉백 기본 원판(맵 15) 봇 판 — 드럼통이 없는지 확인용 대조",
  "repeat": 1,
  "setup": [
    {
      "op": "play_exit"
    },
    {
      "op": "set_environment",
      "env": "local-k8s"
    },
    {
      "op": "play_enter"
    },
    {
      "op": "boot_to_lobby",
      "timeout_s": 120
    }
  ],
  "loop": [
    {
      "op": "select_game",
      "game_mode_id": 11,
      "queue": "casual",
      "map_id": 15
    },
    {
      "op": "ui_click",
      "name": "play-button",
      "timeout_s": 20
    },
    {
      "op": "wait_state",
      "state": "InMatch",
      "timeout_s": 180
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "screenshot",
      "as": "start"
    },
    {
      "op": "screenshot",
      "as": "cancelled"
    },
    {
      "op": "touch",
      "device": "touch",
      "x": 0.7,
      "y": 0.75
    },
    {
      "op": "screenshot",
      "as": "auto-shot"
    },
    {
      "op": "wait",
      "seconds": 1.5
    },
    {
      "op": "drag",
      "device": "touch",
      "x": 0.58,
      "y": 0.45,
      "to_x": 0.58,
      "to_y": 0.25,
      "duration_ms": 700
    },
    {
      "op": "screenshot",
      "as": "aimed-shot"
    },
    {
      "op": "wait_state",
      "state": "PostMatch",
      "scene": "Result",
      "timeout_s": 300
    },
    {
      "op": "ui_wait",
      "name": "confirm-button",
      "clickable": true,
      "timeout_s": 30
    },
    {
      "op": "screenshot",
      "as": "result"
    },
    {
      "op": "ui_click",
      "name": "confirm-button",
      "timeout_s": 10
    },
    {
      "op": "wait_state",
      "state": "FrontEnd",
      "scene": "Lobby",
      "timeout_s": 60
    }
  ],
  "teardown": [
    {
      "op": "play_exit"
    }
  ]
}