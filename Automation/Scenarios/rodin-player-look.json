{
  "name": "rodin-player-look",
  "description": "선수 몸(RodinA) 확인 — 판(봇 채움)에서 카운트다운 뒤 바로 걷고(긴 끌기, 아래 = 판 가운데 쪽) 쏘고, 결과 시상대(표정)와 로비까지 스크린샷. 걷는 동안의 몸은 이 시나리오를 돌리는 동안 따로 unity cmd screenshot(게임 뷰)으로 찍는다. game_mode_id: 11 넉백 개인전 · 12 팀전 · 9 피하기 · 13 카드 러시",
  "repeat": 1,
  "setup": [
    {
      "op": "play_exit"
    },
    {
      "op": "set_environment",
      "env": "local-k8s"
    },
    {
      "op": "play_enter"
    },
    {
      "op": "boot_to_lobby",
      "timeout_s": 120
    },
    {
      "op": "screenshot",
      "as": "lobby"
    }
  ],
  "loop": [
    {
      "op": "select_game",
      "game_mode_id": 11,
      "queue": "casual"
    },
    {
      "op": "ui_click",
      "name": "play-button",
      "timeout_s": 20
    },
    {
      "op": "wait_state",
      "state": "InMatch",
      "timeout_s": 180
    },
    {
      "op": "wait",
      "seconds": 10
    },
    {
      "op": "screenshot",
      "as": "start"
    },
    {
      "op": "drag",
      "device": "touch",
      "x": 0.18,
      "y": 0.75,
      "to_x": 0.18,
      "to_y": 0.88,
      "duration_ms": 4000
    },
    {
      "op": "touch",
      "device": "touch",
      "x": 0.7,
      "y": 0.75
    },
    {
      "op": "wait",
      "seconds": 0.5
    },
    {
      "op": "screenshot",
      "as": "walked-shot"
    },
    {
      "op": "drag",
      "device": "touch",
      "x": 0.18,
      "y": 0.75,
      "to_x": 0.3,
      "to_y": 0.75,
      "duration_ms": 3000
    },
    {
      "op": "screenshot",
      "as": "walked-side"
    },
    {
      "op": "wait_state",
      "state": "PostMatch",
      "scene": "Result",
      "timeout_s": 300
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "screenshot",
      "as": "result"
    },
    {
      "op": "wait",
      "seconds": 4
    },
    {
      "op": "screenshot",
      "as": "result-later"
    },
    {
      "op": "ui_click",
      "name": "confirm-button",
      "timeout_s": 30
    },
    {
      "op": "wait_state",
      "state": "FrontEnd",
      "scene": "Lobby",
      "timeout_s": 60
    },
    {
      "op": "wait",
      "seconds": 3
    },
    {
      "op": "screenshot",
      "as": "lobby-after"
    }
  ],
  "teardown": []
}